    "@prisma/client": "^6.16.3",
    "@safety/contracts": "workspace:*",
    "argon2": "^0.44.0",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "unzipper": "0.12.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
