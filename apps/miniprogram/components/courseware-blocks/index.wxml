<view class="courseware-document">
  <view wx:if="{{!totalBlocks}}" class="empty-content">
    <text class="unknown-title">课件暂无可学习内容</text>
    <text class="unknown-copy">请联系培训管理员检查课件内容后再试。</text>
  </view>
  <view wx:elif="{{currentUnit && currentBlock}}" class="courseware-unit">
    <view class="unit-heading">
      <text class="unit-kicker">单元 {{currentUnitIndex + 1}}</text>
      <text class="unit-title">{{currentUnit.title}}</text>
      <text class="unit-meta">预计 {{currentUnit.estimatedMinutes}} 分钟</text>
    </view>

    <view id="{{currentBlock.domId}}" class="content-block active-block content-block-{{currentBlock.type}}">
      <block wx:if="{{currentBlock.type === 'knowledge'}}">
        <text class="block-label">知识要点</text>
        <text class="block-title">{{currentBlock.title}}</text>
        <text class="block-body" user-select>{{currentBlock.body}}</text>
        <view wx:if="{{currentBlock.image}}" class="block-image-shell">
          <text wx:if="{{currentBlock.image.loading}}" class="image-status">正在安全读取图片…</text>
          <image wx:elif="{{currentBlock.image.path}}" class="block-image" src="{{currentBlock.image.path}}" mode="widthFix" alt="{{currentBlock.title}}配图"></image>
          <view wx:else class="image-error">
            <text class="image-status">{{currentBlock.image.error || '图片暂时无法显示'}}</text>
            <button class="compact-action" bindtap="retryImage">重新读取</button>
          </view>
        </view>
      </block>

      <block wx:elif="{{currentBlock.type === 'do_dont'}}">
        <text class="block-label">正误对照</text>
        <text class="block-title">{{currentBlock.title}}</text>
        <view class="compare-section compare-do">
          <text class="compare-title">应该这样做</text>
          <view wx:for="{{currentBlock.dos}}" wx:key="*this" wx:for-item="item" class="list-row"><text class="list-index">{{index + 1}}</text><text class="list-copy">{{item}}</text></view>
        </view>
        <view class="compare-section compare-dont">
          <text class="compare-title">不要这样做</text>
          <view wx:for="{{currentBlock.donts}}" wx:key="*this" wx:for-item="item" class="list-row"><text class="list-index">{{index + 1}}</text><text class="list-copy">{{item}}</text></view>
        </view>
      </block>

      <block wx:elif="{{currentBlock.type === 'steps'}}">
        <text class="block-label">操作步骤</text>
        <text class="block-title">{{currentBlock.title}}</text>
        <view wx:for="{{currentBlock.steps}}" wx:key="*this" wx:for-item="item" class="step-row">
          <text class="step-number">{{index + 1}}</text><text class="list-copy">{{item}}</text>
        </view>
      </block>

      <block wx:elif="{{currentBlock.type === 'checkpoint'}}">
        <text class="block-label">随堂练习 · {{currentBlock.questionType === 'multiple_choice' ? '多选' : currentBlock.questionType === 'true_false' ? '判断' : '单选'}}</text>
        <text class="checkpoint-prompt">{{currentBlock.prompt}}</text>
        <view wx:for="{{currentBlock.options}}" wx:key="index" wx:for-item="option" class="choice-button {{option.selected ? 'choice-selected' : ''}}" data-option-index="{{option.index}}" bindtap="selectCheckpointOption" hover-class="choice-pressed" aria-role="button" aria-label="{{option.selected ? '已选择' : '未选择'}}，{{option.label}}">
          <text class="choice-marker">{{option.selected ? '已选择' : '选择'}}</text><text class="choice-copy">{{option.label}}</text>
        </view>
        <view class="answer-button {{!currentBlock.hasSelection ? 'control-disabled' : ''}}" bindtap="submitCheckpoint" hover-class="{{currentBlock.hasSelection ? 'control-pressed' : 'none'}}" aria-role="button" aria-disabled="{{!currentBlock.hasSelection}}">查看答案与解释</view>
        <view wx:if="{{currentBlock.feedback}}" class="feedback {{currentBlock.feedback.correct ? 'feedback-correct' : 'feedback-incorrect'}}" aria-live="polite">
          <text class="feedback-title">{{currentBlock.feedback.text}}</text>
          <text class="feedback-copy">{{currentBlock.feedback.explanation}}</text>
          <text class="feedback-note">本题只用于帮助理解，不计入正式考试成绩。</text>
        </view>
      </block>

      <block wx:elif="{{currentBlock.type === 'scenario'}}">
        <text class="block-label">情境选择</text>
        <text class="checkpoint-prompt">{{currentBlock.prompt}}</text>
        <view wx:for="{{currentBlock.scenarioChoices}}" wx:key="index" wx:for-item="choice" class="choice-button {{choice.selected ? 'choice-selected' : ''}}" data-choice-index="{{choice.index}}" bindtap="selectScenarioChoice" hover-class="choice-pressed" aria-role="button" aria-label="{{choice.selected ? '已选择' : '未选择'}}，{{choice.label}}">
          <text class="choice-marker">{{choice.selected ? '已选择' : '选择'}}</text><text class="choice-copy">{{choice.label}}</text>
        </view>
        <view wx:if="{{currentBlock.scenarioFeedback}}" class="scenario-feedback" aria-live="polite">
          <text class="feedback-title">选择后的影响</text><text class="feedback-copy">{{currentBlock.scenarioFeedback.consequence}}</text>
          <text class="feedback-title basis-title">判断依据</text><text class="feedback-copy">{{currentBlock.scenarioFeedback.basis}}</text>
        </view>
      </block>

      <block wx:elif="{{currentBlock.type === 'summary'}}">
        <text class="block-label">本节小结</text>
        <view wx:for="{{currentBlock.points}}" wx:key="*this" wx:for-item="item" class="summary-row"><text class="summary-number">{{index + 1}}</text><text class="list-copy">{{item}}</text></view>
      </block>

      <view wx:else class="unknown-block">
        <text class="unknown-title">暂时无法显示这段内容</text>
        <text class="unknown-copy">此内容需要升级小程序后查看。</text>
      </view>

      <view class="navigation-actions">
        <view class="previous-button {{activeGlobalIndex === 0 ? 'control-disabled' : ''}}" bindtap="showPreviousBlock" hover-class="{{activeGlobalIndex > 0 ? 'control-pressed' : 'none'}}" aria-role="button" aria-disabled="{{activeGlobalIndex === 0}}">上一项</view>
        <view class="continue-button {{!canContinue ? 'control-disabled' : ''}}" bindtap="confirmBlockReached" hover-class="{{canContinue ? 'control-pressed' : 'none'}}" aria-role="button" aria-disabled="{{!canContinue}}">{{!currentBlock.known ? '请升级小程序后继续' : currentBlock.isLast ? '本人确认已阅读至末尾' : '继续下一项'}}</view>
      </view>
    </view>
  </view>
</view>
