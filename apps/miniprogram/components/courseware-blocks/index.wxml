<view class="courseware-document">
  <view wx:for="{{preparedUnits}}" wx:key="key" wx:for-item="unit" wx:for-index="unitIndex" class="courseware-unit">
    <view class="unit-heading">
      <text class="unit-kicker">单元 {{unitIndex + 1}}</text>
      <text class="unit-title">{{unit.title}}</text>
      <text class="unit-meta">预计 {{unit.estimatedMinutes}} 分钟</text>
    </view>

    <view wx:for="{{unit.blocks}}" wx:key="key" wx:for-item="block" wx:for-index="blockIndex" id="{{block.domId}}" class="content-block content-block-{{block.type}}">
      <block wx:if="{{block.type === 'knowledge'}}">
        <text class="block-label">知识要点</text>
        <text class="block-title">{{block.title}}</text>
        <text class="block-body" user-select>{{block.body}}</text>
        <view wx:if="{{block.image}}" class="block-image-shell">
          <text wx:if="{{block.image.loading}}" class="image-status">正在安全读取图片…</text>
          <image wx:elif="{{block.image.path}}" class="block-image" src="{{block.image.path}}" mode="widthFix" alt="{{block.title}}配图"></image>
          <view wx:else class="image-error">
            <text class="image-status">{{block.image.error || '图片暂时无法显示'}}</text>
            <button class="compact-action" data-unit-index="{{unitIndex}}" data-block-index="{{blockIndex}}" bindtap="retryImage">重新读取</button>
          </view>
        </view>
      </block>

      <block wx:elif="{{block.type === 'do_dont'}}">
        <text class="block-label">正误对照</text>
        <text class="block-title">{{block.title}}</text>
        <view class="compare-section compare-do">
          <text class="compare-title">应该这样做</text>
          <view wx:for="{{block.dos}}" wx:key="*this" wx:for-item="item" class="list-row"><text class="list-index">{{index + 1}}</text><text class="list-copy">{{item}}</text></view>
        </view>
        <view class="compare-section compare-dont">
          <text class="compare-title">不要这样做</text>
          <view wx:for="{{block.donts}}" wx:key="*this" wx:for-item="item" class="list-row"><text class="list-index">{{index + 1}}</text><text class="list-copy">{{item}}</text></view>
        </view>
      </block>

      <block wx:elif="{{block.type === 'steps'}}">
        <text class="block-label">操作步骤</text>
        <text class="block-title">{{block.title}}</text>
        <view wx:for="{{block.steps}}" wx:key="*this" wx:for-item="item" class="step-row">
          <text class="step-number">{{index + 1}}</text><text class="list-copy">{{item}}</text>
        </view>
      </block>

      <block wx:elif="{{block.type === 'checkpoint'}}">
        <text class="block-label">随堂练习 · {{block.questionType === 'multiple_choice' ? '多选' : block.questionType === 'true_false' ? '判断' : '单选'}}</text>
        <text class="checkpoint-prompt">{{block.prompt}}</text>
        <button wx:for="{{block.options}}" wx:key="index" wx:for-item="option" class="choice-button {{option.selected ? 'choice-selected' : ''}}" data-unit-index="{{unitIndex}}" data-block-index="{{blockIndex}}" data-option-index="{{option.index}}" bindtap="selectCheckpointOption" aria-label="{{option.selected ? '已选择' : '未选择'}}，{{option.label}}">
          <text class="choice-marker">{{option.selected ? '已选择' : '选择'}}</text><text class="choice-copy">{{option.label}}</text>
        </button>
        <button class="answer-button" data-unit-index="{{unitIndex}}" data-block-index="{{blockIndex}}" disabled="{{!block.hasSelection}}" bindtap="submitCheckpoint">查看答案与解释</button>
        <view wx:if="{{block.feedback}}" class="feedback {{block.feedback.correct ? 'feedback-correct' : 'feedback-incorrect'}}" aria-live="polite">
          <text class="feedback-title">{{block.feedback.text}}</text>
          <text class="feedback-copy">{{block.feedback.explanation}}</text>
          <text class="feedback-note">本题只用于帮助理解，不计入正式考试成绩。</text>
        </view>
      </block>

      <block wx:elif="{{block.type === 'scenario'}}">
        <text class="block-label">情境选择</text>
        <text class="checkpoint-prompt">{{block.prompt}}</text>
        <button wx:for="{{block.scenarioChoices}}" wx:key="index" wx:for-item="choice" class="choice-button {{choice.selected ? 'choice-selected' : ''}}" data-unit-index="{{unitIndex}}" data-block-index="{{blockIndex}}" data-choice-index="{{choice.index}}" bindtap="selectScenarioChoice">
          <text class="choice-marker">{{choice.selected ? '已选择' : '选择'}}</text><text class="choice-copy">{{choice.label}}</text>
        </button>
        <view wx:if="{{block.scenarioFeedback}}" class="scenario-feedback" aria-live="polite">
          <text class="feedback-title">选择后的影响</text><text class="feedback-copy">{{block.scenarioFeedback.consequence}}</text>
          <text class="feedback-title basis-title">判断依据</text><text class="feedback-copy">{{block.scenarioFeedback.basis}}</text>
        </view>
      </block>

      <block wx:elif="{{block.type === 'summary'}}">
        <text class="block-label">本节小结</text>
        <view wx:for="{{block.points}}" wx:key="*this" wx:for-item="item" class="summary-row"><text class="summary-number">{{index + 1}}</text><text class="list-copy">{{item}}</text></view>
      </block>

      <view wx:else class="unknown-block">
        <text class="unknown-title">暂时无法显示这段内容</text>
        <text class="unknown-copy">此内容需要升级小程序后查看。</text>
      </view>

      <button class="continue-button" data-unit-index="{{unitIndex}}" data-block-index="{{blockIndex}}" disabled="{{!block.known || block.type === 'checkpoint' && !block.feedback || block.type === 'scenario' && !block.scenarioFeedback}}" bindtap="confirmBlockReached">{{!block.known ? '请升级小程序后继续' : block.isLast ? '本人确认已阅读至末尾' : '继续下一项'}}</button>
    </view>
  </view>
</view>
