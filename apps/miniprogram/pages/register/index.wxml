<view class="page"><form bindsubmit="submit"><view class="card"><text class="title">人工审核资料</text><text class="label">姓名</text><input class="field" name="name" placeholder="请输入真实姓名"/><text class="label">手机号</text><input class="field" name="phone" type="number" maxlength="11"/><text class="label">身份证号码</text><input class="field" name="nationalId" password="true"/><text class="label">人员类型</text><radio-group bindchange="chooseType"><label><radio value="contractor" checked="true"/>外协人员</label><label><radio value="temporary_individual"/>临时个人</label></radio-group><block wx:if="{{type === 'contractor'}}"><text class="label">外协单位</text><picker range="{{organizations}}" range-key="name" bindchange="chooseOrg"><view class="field">{{orgIndex >= 0 ? organizations[orgIndex].name : '请选择外协单位'}}</view></picker></block><text class="label">申请项目及责任经营实体</text><picker range="{{projects}}" range-key="name" bindchange="chooseProject"><view class="field">{{projectIndex >= 0 ? projects[projectIndex].name + ' · ' + projects[projectIndex].responsibleOrganization.name : '请选择项目'}}</view></picker><button class="secondary" bindtap="choosePhoto">{{photoFileId ? '照片已上传' : '上传个人照片'}}</button><button class="primary" form-type="submit" loading="{{busy}}">提交审核</button></view></form></view>
