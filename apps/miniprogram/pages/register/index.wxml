<view class="page register-page">
  <view class="page-head"><text class="page-title">人员注册申请</text><text class="page-description">外协人员和临时个人可提交资料，由项目管理人员审核。</text></view>
  <form bindsubmit="submit"><view class="card form-card">
    <text class="subtitle">人员类型</text>
    <radio-group class="type-segment" bindchange="chooseType">
      <label class="type-option {{type === 'contractor' ? 'type-option-active' : ''}}"><radio value="contractor" checked="{{type === 'contractor'}}"/>外协人员</label>
      <label class="type-option {{type === 'temporary_individual' ? 'type-option-active' : ''}}"><radio value="temporary_individual" checked="{{type === 'temporary_individual'}}"/>临时个人</label>
    </radio-group>
    <text class="label">姓名</text><input class="field" name="name" placeholder="请输入真实姓名"/>
    <text class="label">手机号</text><input class="field" name="phone" type="number" maxlength="11" placeholder="请输入本人手机号"/>
    <text class="label">身份证号码</text><input class="field" name="nationalId" password="true" placeholder="仅用于身份核验，默认不明文显示"/>
    <block wx:if="{{type === 'contractor'}}"><text class="label">外协单位</text><picker range="{{organizations}}" range-key="name" bindchange="chooseOrg"><view class="field picker-field">{{orgIndex >= 0 ? organizations[orgIndex].name : '请选择外协单位'}}</view></picker></block>
    <text class="label">申请加入项目</text><picker range="{{projects}}" range-key="name" bindchange="chooseProject"><view class="field picker-field">{{projectIndex >= 0 ? projects[projectIndex].name + ' · ' + projects[projectIndex].responsibleOrganization.name : '请选择项目'}}</view></picker>
    <view class="photo-row"><view><text class="label">个人照片</text><text class="muted">用于人员档案，文件为私有访问</text></view><button class="photo-button" bindtap="choosePhoto"><t-icon name="camera" size="30rpx" />{{photoFileId ? '已上传' : '上传照片'}}</button></view>
    <view class="info-strip"><t-icon name="info-circle" size="30rpx" /><text>提交后不会自动获得管理权限；审核通过后才建立人员与项目关系。</text></view>
    <button class="primary submit-button" form-type="submit" loading="{{busy}}" disabled="{{busy}}">提交审核</button>
  </view></form>
</view>
<environment-badge />
