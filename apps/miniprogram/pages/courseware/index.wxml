<view class="page"><view wx:if="{{loading}}" class="card empty">正在加载课件…</view><view wx:elif="{{error}}" class="card error">{{error}}</view><block wx:elif="{{content}}"><view class="card"><text class="title">{{content.title}}</text><rich-text wx:if="{{content.type === 'rich_text'}}" nodes="{{content.richText}}"></rich-text><block wx:else><text class="muted">HTML 交互课件将在受控页面中打开，链接五分钟内有效。</text><button class="secondary" bindtap="openHtml">打开 HTML 课件</button></block></view><view class="card"><text class="muted">请确认已浏览到课件末尾，再主动完成本次学习。</text><button class="primary" loading="{{busy}}" bindtap="complete">完成学习</button></view></block></view>
