.courseware-page { max-width: 980rpx; margin: 0 auto; }
.state-panel { padding: 54rpx 34rpx; background: var(--surface); border-radius: var(--radius-card); box-shadow: var(--elevation); text-align: center; }
.state-title { display: block; margin-bottom: 12rpx; font-size: 34rpx; line-height: 1.3; font-weight: 650; }
.state-copy, .section-copy { display: block; color: var(--muted); font-size: 28rpx; line-height: 1.65; }
.state-error .state-title { color: var(--danger); }
.reader-heading, .reader-content, .html-panel, .finish-panel { padding: 32rpx; margin-bottom: 24rpx; background: var(--surface); border: 1rpx solid var(--line); border-radius: 32rpx; box-shadow: var(--elevation); }
.reader-heading { padding:10rpx 2rpx 24rpx; background:transparent; border:0; border-radius:0; box-shadow:none; }
.progress-dock { position: sticky; top: 0; z-index: 5; padding: 20rpx 24rpx; margin: 0 0 24rpx; background: rgba(255, 255, 255, .97); border: 1rpx solid #B9DCFF; border-radius: 22rpx; box-shadow: 0 8rpx 26rpx rgba(8, 103, 198, .10); }
.progress-copy-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.progress-label { color: var(--ink); font-size: 28rpx; font-weight: 650; }
.progress-position { flex: 0 0 auto; color: var(--action); font-size: 27rpx; font-weight: 650; }
.progress-unit { display: block; margin-top: 6rpx; overflow: hidden; color: var(--muted); font-size: 25rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.progress-dock .progress { margin-top: 14rpx; }
.progress-warning { display: block; margin-top: 10rpx; color: var(--warning); font-size: 25rpx; line-height: 1.45; }
.course-title { display: block; font-size: 38rpx; line-height: 1.3; font-weight: 750; letter-spacing: -.5rpx; }
.resume-copy { display: block; margin-top: 18rpx; color: var(--muted); font-size: 28rpx; line-height: 1.5; }
.reader-content { padding: 38rpx 34rpx; }
.reader-content rich-text { color: var(--ink-soft); font-size: 31rpx; line-height: 1.9; word-break: break-word; }
.rich-end-action { padding-top: 28rpx; margin-top: 34rpx; border-top: 1rpx solid var(--line); }
.section-title { display: block; margin-bottom: 10rpx; font-size: 34rpx; line-height: 1.35; font-weight: 650; }
.html-button, .attestation-button, .end-confirm-button, .finish-button { width: 100%; }
.retry-button { width: 100%; }
.attestation-button { margin-top: 18rpx; }
.attestation-success { display: flex; align-items: center; gap: 10rpx; margin-top: 18rpx; color: var(--success); font-size: 28rpx; line-height: 1.5; font-weight: 600; }
.sync-warning { display: block; margin-top: 18rpx; color: var(--warning); font-size: 28rpx; line-height: 1.5; }
.success-copy { color: var(--success); }
.action-error { margin-top: 18rpx; }
courseware-blocks { display: block; margin-bottom: 24rpx; }

@media (min-width: 700px) {
  .courseware-page { padding-left: 48rpx; padding-right: 48rpx; }
  .reader-heading, .reader-content, .html-panel, .finish-panel { padding-left: 48rpx; padding-right: 48rpx; }
}
