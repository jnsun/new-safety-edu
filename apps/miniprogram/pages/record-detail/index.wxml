<view class="page"><view wx:if="{{loading}}" class="card empty">正在加载…</view><view wx:elif="{{error}}" class="card error">{{error}}</view><block wx:elif="{{record}}"><view class="card"><text class="title">{{record.batch.name}}</text><text class="muted">{{record.typeText}}</text><view class="divider"></view><view class="row"><text>完成时间</text><text>{{record.completedText}}</text></view><view class="row"><text>最终状态</text><text class="status">{{record.statusText}}</text></view><view class="row"><text>本人签字</text><text>{{record.signedAt ? '已于 ' + record.signedAt + ' 提交' : '未签字'}}</text></view></view><view class="card"><text class="title">当时学习内容</text><view wx:for="{{record.coursewares}}" wx:key="progressId" class="row"><text>{{index + 1}}. {{item.title}}（v{{item.version}}）</text><text class="success">已完成</text></view></view><view class="card"><text class="title">考试结果</text><view class="row"><text>考试次数</text><text>第 {{record.latestAttempt.attemptNumber}} 次</text></view><view class="row"><text>成绩</text><text>{{record.latestAttempt.score}} 分</text></view><view class="row"><text>结果</text><text class="{{record.latestAttempt.passed ? 'success' : 'warning'}}">{{record.latestAttempt.passed ? '通过' : '未通过'}}</text></view></view></block></view>
