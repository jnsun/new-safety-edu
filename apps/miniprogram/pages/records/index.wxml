<view class="page records-page">
  <view class="page-heading">
    <text class="page-title">我的培训记录</text>
    <text class="page-copy">查看本人已形成的学习、考试、签字和项目确认事实。</text>
  </view>

  <view wx:if="{{loading}}" class="state-panel">
    <view class="state-icon"><t-loading size="48rpx" /></view>
    <text class="state-title">正在加载培训记录</text>
    <text class="state-copy">请稍候。</text>
  </view>
  <view wx:elif="{{error}}" class="state-panel state-error">
    <view class="state-icon"><t-icon name="error-circle" size="48rpx" /></view>
    <text class="state-title">培训记录加载失败</text>
    <text class="state-copy">{{error}}</text>
    <button class="secondary retry-button" bindtap="load">重新加载</button>
  </view>
  <view wx:elif="{{!records.length}}" class="state-panel">
    <view class="state-icon"><t-icon name="file-paste" size="48rpx" /></view>
    <text class="state-title">暂无培训记录</text>
    <text class="state-copy">完成培训或提交签字后，记录会显示在这里。</text>
  </view>

  <view wx:for="{{records}}" wx:key="id" class="record-item" aria-role="button" hover-class="tap-active" data-id="{{item.id}}" bindtap="open">
    <view class="record-head">
      <view class="record-heading-copy">
        <text class="record-title">{{item.batch.name}}</text>
        <text class="record-type">{{item.typeText}}</text>
      </view>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="record-facts">
      <view class="fact-row"><text class="fact-label">完成时间</text><text class="fact-value">{{item.completedText}}</text></view>
      <view class="fact-row"><text class="fact-label">最终成绩</text><text class="fact-value">{{item.finalScoreText}}</text></view>
      <view class="fact-row"><text class="fact-label">考试结果</text><text class="fact-value {{item.passClass}}">{{item.passText}}</text></view>
      <view class="fact-row"><text class="fact-label">本人签字</text><text class="fact-value">{{item.signatureText}}</text></view>
    </view>
    <view class="detail-link"><text>查看完整记录</text><t-icon name="chevron-right" size="32rpx" /></view>
  </view>
</view>
<environment-badge />
