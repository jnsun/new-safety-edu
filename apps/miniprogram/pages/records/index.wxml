<view class="page"><text class="title">我的培训记录</text><view wx:if="{{loading}}" class="card empty">正在加载…</view><view wx:elif="{{error}}" class="card error">{{error}}</view><view wx:elif="{{!records.length}}" class="card empty">暂无已完成记录</view><view wx:for="{{records}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="title">{{item.batch.name}}</text><text class="status">{{item.statusText}}</text></view><text class="muted">{{item.typeText}}</text><view class="divider"></view><view class="row"><text>完成时间</text><text>{{item.completedText}}</text></view><block wx:if="{{item.batch.examRequired}}"><view class="row"><text>考试成绩</text><text>{{item.latestAttempt ? item.latestAttempt.score + ' 分' : '—'}}</text></view><view class="row"><text>考试结果</text><text class="{{item.latestAttempt && item.latestAttempt.passed ? 'success' : 'warning'}}">{{item.latestAttempt && item.latestAttempt.passed ? '通过' : '未通过'}}</text></view></block><view wx:else class="row"><text>考试</text><text>本次不要求考试</text></view><view class="row"><text>本人签字</text><text>{{item.signedAt ? '已签字' : '未签字'}}</text></view></view></view>
