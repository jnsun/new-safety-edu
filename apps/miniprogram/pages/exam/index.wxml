<view class="page"><view class="exam-head"><text>第 {{attempt.attemptNumber || '-'}} 次考试</text><text class="timer">剩余 {{remaining}}</text></view><view wx:if="{{error}}" class="card error">{{error}}</view><view wx:for="{{questions}}" wx:key="id" class="card question"><text class="title">{{index + 1}}. {{item.prompt}}</text><text class="muted">{{item.type === 'multiple_choice' ? '多选题' : (item.type === 'true_false' ? '判断题' : '单选题')}}</text><checkbox-group wx:if="{{item.type === 'multiple_choice'}}" data-id="{{item.id}}" bindchange="chooseMany"><label wx:for="{{item.options}}" wx:for-item="option" wx:key="label" class="option"><checkbox value="{{option.label}}" checked="{{option.checked}}"/>{{option.label}}</label></checkbox-group><radio-group wx:else data-id="{{item.id}}" bindchange="chooseOne"><label wx:for="{{item.options}}" wx:for-item="option" wx:key="label" class="option"><radio value="{{option.label}}" checked="{{option.checked}}"/>{{option.label}}</label></radio-group></view><button wx:if="{{attempt}}" class="primary submit" loading="{{busy}}" bindtap="submit">确认交卷</button></view>
