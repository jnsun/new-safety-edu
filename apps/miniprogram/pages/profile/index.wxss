.profile-page { min-height:100vh; padding:28rpx 32rpx calc(156rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:var(--canvas); }
.profile-state { margin-top:10rpx; }
.retry-button { width:100%; margin-top:28rpx; }
.profile-card,.points-card { width:100%; margin-bottom:24rpx; box-sizing:border-box; background:var(--surface); border:1rpx solid var(--line); border-radius:32rpx; box-shadow:var(--elevation); }
.profile-summary { display:grid; grid-template-columns:112rpx minmax(0,1fr) auto; align-items:center; gap:22rpx; min-height:176rpx; padding:28rpx; }
.avatar-wrap { position:relative; width:112rpx; height:112rpx; }
.profile-avatar { width:112rpx; height:112rpx; border-radius:50%; background:var(--action-soft); }
.avatar-placeholder { display:flex; align-items:center; justify-content:center; color:var(--action); }
.photo-hint { position:absolute; right:-2rpx; bottom:-2rpx; display:flex; width:42rpx; height:42rpx; align-items:center; justify-content:center; color:#fff; background:var(--action); border:4rpx solid #fff; border-radius:50%; }
.identity-main,.row-copy,.heading-copy { min-width:0; }
.identity-title-line { display:flex; align-items:center; flex-wrap:wrap; gap:12rpx; }
.identity-name { font-size:38rpx; font-weight:750; }
.type-pill { padding:7rpx 15rpx; color:var(--action); background:var(--action-soft); border-radius:999rpx; font-size:23rpx; font-weight:650; }
.identity-organization,.identity-phone { display:block; margin-top:7rpx; overflow:hidden; color:var(--muted); font-size:26rpx; line-height:1.4; text-overflow:ellipsis; white-space:nowrap; }
.points-card { padding:26rpx 28rpx; }
.card-heading-button,.single-link,.profile-list-row { display:grid; grid-template-columns:72rpx minmax(0,1fr) auto; align-items:center; gap:18rpx; }
.round-icon { display:flex; width:72rpx; height:72rpx; align-items:center; justify-content:center; color:var(--action); background:var(--action-soft); border-radius:50%; }
.points-icon { color:#fff; background:var(--action); }
.card-heading,.row-title { display:block; font-size:31rpx; line-height:1.35; font-weight:700; }
.card-subtitle,.row-subtitle { display:block; margin-top:4rpx; color:var(--muted); font-size:24rpx; line-height:1.4; }
.row-chevron { color:#7E858F; }
.points-panel { display:grid; grid-template-columns:repeat(3,1fr); margin-top:22rpx; padding-top:22rpx; border-top:1rpx solid var(--line); }
.points-column { text-align:center; border-right:1rpx solid var(--line); }
.points-column:last-child { border-right:0; }
.points-value,.points-label { display:block; }
.points-value { color:var(--action); font-size:42rpx; font-weight:750; }
.points-label { margin-top:3rpx; color:var(--muted); font-size:23rpx; }
.single-link { min-height:128rpx; padding:24rpx 28rpx; }
.profile-section-title { display:block; margin:34rpx 2rpx 16rpx; font-size:31rpx; font-weight:700; }
.service-grid { display:grid; grid-template-columns:1fr 1fr; overflow:hidden; }
.service-item { display:grid; grid-template-columns:58rpx minmax(0,1fr) auto; min-height:112rpx; padding:20rpx 22rpx; align-items:center; gap:12rpx; box-sizing:border-box; border-right:1rpx solid var(--line); border-bottom:1rpx solid var(--line); font-size:26rpx; font-weight:600; }
.service-item:nth-child(2n) { border-right:0; }
.service-item:nth-last-child(-n+2) { border-bottom:0; }
.service-item .round-icon { width:58rpx; height:58rpx; }
.transfer-card { padding:28rpx; }
.transfer-card .field { margin-bottom:16rpx; }
.transfer-reason { min-height:150rpx; }
.action-list-card { overflow:hidden; padding:0 28rpx; }
.profile-list-row { min-height:116rpx; }
.list-divider { height:1rpx; background:var(--line); }
.logout-button { width:100%; min-height:88rpx; margin-top:8rpx; color:var(--danger); background:var(--surface); border:2rpx solid #EF5B6D; border-radius:24rpx; font-size:29rpx; font-weight:650; }
@media (min-width:700px) { .profile-page { max-width:1000rpx; margin:0 auto; padding-left:48rpx; padding-right:48rpx; } }
