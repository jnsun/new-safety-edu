.profile-page {
  min-height: 100vh;
  padding: 24rpx 22rpx calc(52rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--ink);
  background: var(--canvas);
}

.profile-state { margin-top: 10rpx; }
.retry-button { width: 100%; margin-top: 28rpx; }

.profile-card,
.points-card {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  border-radius: var(--radius-card);
  background: var(--surface);
  box-shadow: var(--elevation);
}

.profile-summary { padding: 34rpx 28rpx 12rpx; }
.profile-identity { display: flex; align-items: center; min-height: 178rpx; gap: 30rpx; padding-bottom: 26rpx; }
.avatar-wrap { position: relative; flex: 0 0 auto; width: 172rpx; height: 172rpx; }
.profile-avatar { width: 172rpx; height: 172rpx; border-radius: 50%; background: var(--action-soft); }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; color: var(--action); }
.photo-action {
  position: absolute;
  left: 13rpx;
  right: 13rpx;
  bottom: -6rpx;
  min-height: 44rpx;
  padding: 0 12rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #fff;
  background: var(--action);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: var(--elevation);
}

.identity-main { min-width: 0; flex: 1; }
.identity-title-line { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; }
.identity-name { font-size: 42rpx; line-height: 1.28; font-weight: 700; letter-spacing: -.5rpx; }
.type-pill,
.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-height: 50rpx;
  padding: 0 23rpx;
  border-radius: 999rpx;
  color: var(--action);
  background: var(--action-soft);
  font-size: 25rpx;
  font-weight: 600;
}
.identity-organization { display: block; margin-top: 13rpx; color: var(--muted); font-size: 30rpx; line-height: 1.45; }

.profile-divider,
.list-divider { height: 1rpx; background: var(--line); }
.detail-row { display: grid; grid-template-columns: 126rpx minmax(0, 1fr) auto; align-items: center; min-height: 96rpx; gap: 18rpx; }
.detail-label { font-size: 29rpx; color: var(--ink); }
.detail-value { min-width: 0; color: var(--ink); font-size: 29rpx; line-height: 1.45; }
.detail-value-grow { flex: 1; }
.inline-link {
  flex: 0 0 auto;
  width: auto;
  min-height: 72rpx;
  padding: 0;
  margin: 0;
  color: var(--action);
  background: transparent;
  font-size: 27rpx;
  font-weight: 600;
}

.points-card { padding: 28rpx; background: #EEF7F3; }
.card-heading-button,
.profile-list-row,
.security-row {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: var(--ink);
  background: transparent;
  text-align: left;
  line-height: 1.35;
}
.card-heading-button,
.profile-list-row { display: grid; grid-template-columns: 78rpx minmax(0, 1fr) auto; }
.card-heading-button { min-height: 102rpx; }
.round-icon {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  background: var(--action-soft);
  border-radius: 50%;
}
.round-icon-strong { color: #fff; background: var(--action); box-shadow: var(--elevation); }
.heading-copy,
.row-copy { min-width: 0; flex: 1; }
.card-heading,
.row-title,
.card-subtitle,
.row-subtitle,
.row-helper { display: block; }
.card-heading { color: var(--ink); font-size: 34rpx; line-height: 1.35; font-weight: 700; }
.card-subtitle { margin-top: 5rpx; color: var(--muted); font-size: 27rpx; line-height: 1.4; font-weight: 400; }
.row-chevron { flex: 0 0 auto; color: var(--muted); transition: transform .18s ease-out; }
.chevron-open { transform: rotate(90deg); }

.points-panel {
  display: flex;
  align-items: center;
  min-height: 166rpx;
  margin-top: 10rpx;
  padding: 18rpx 12rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, .86);
  border-radius: var(--radius-control);
}
.points-column { flex: 1; text-align: center; }
.points-label { display: block; color: var(--muted); font-size: 27rpx; }
.points-value { display: block; margin-top: 8rpx; color: var(--action); font-size: 62rpx; line-height: 1.05; font-weight: 750; font-variant-numeric: tabular-nums; }
.points-separator { width: 1rpx; height: 92rpx; background: var(--line); }

.action-list-card { overflow: hidden; padding: 0 28rpx; }
.profile-list-row,
.security-row { min-height: 122rpx; }
.profile-list-row:active { opacity: .72; }
.row-title { color: var(--ink); font-size: 31rpx; line-height: 1.36; font-weight: 650; }
.row-subtitle { margin-top: 4rpx; color: var(--muted); font-size: 26rpx; line-height: 1.45; font-weight: 400; }
.row-helper { margin-top: 12rpx; color: var(--muted); font-size: 24rpx; line-height: 1.45; font-weight: 400; }
.row-action { flex: 0 0 auto; color: var(--action); font-size: 26rpx; font-weight: 600; white-space: nowrap; }
.row-tail { display: flex; align-items: center; justify-content: flex-end; gap: 7rpx; white-space: nowrap; }

.profile-section-title {
  margin: 42rpx 14rpx 18rpx;
  color: var(--ink);
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: -.5rpx;
}

.certificate-card,
.role-card { padding: 26rpx 26rpx 24rpx; }
.certificate-head { display: flex; align-items: center; min-width: 0; gap: 20rpx; }
.certificate-title { min-width: 0; flex: 1; }
.status-pill { min-height: 46rpx; padding: 0 21rpx; font-size: 24rpx; }
.status-pill-danger { color: var(--danger); background: var(--danger-soft); }
.certificate-detail,
.role-detail {
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-control);
  background: #F0F7F4;
}
.certificate-row { display: grid; grid-template-columns: 160rpx minmax(0, 1fr); gap: 18rpx; padding: 8rpx 0; font-size: 27rpx; line-height: 1.5; }
.certificate-label { color: var(--muted); }
.certificate-value { min-width: 0; color: var(--ink); overflow-wrap: anywhere; }
.role-entry + .role-entry { padding-top: 18rpx; margin-top: 18rpx; border-top: 1rpx solid var(--line); }
.compact-empty { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; }

.inline-form {
  padding: 18rpx 0 28rpx 98rpx;
  border-top: 1rpx solid var(--line);
}
.inline-form .field { min-height: 88rpx; margin: 0 0 18rpx; padding: 20rpx 22rpx; font-size: 27rpx; }
.transfer-reason { min-height: 150rpx; }
.inline-submit { min-height: 88rpx; margin-top: 0; font-size: 28rpx; }

.security-card { overflow: hidden; padding: 0 28rpx; }
.security-action { min-height: 136rpx; }
.session-list { padding: 6rpx 0 20rpx 98rpx; border-top: 1rpx solid var(--line); }
.session-row { display: flex; align-items: center; gap: 16rpx; min-height: 92rpx; border-bottom: 1rpx solid var(--line); }
.session-row:last-child { border-bottom: 0; }
.session-copy { min-width: 0; flex: 1; }
.session-title,
.session-meta { display: block; }
.session-title { color: var(--ink); font-size: 26rpx; font-weight: 600; }
.session-meta { margin-top: 5rpx; color: var(--muted); font-size: 23rpx; line-height: 1.4; }
.current-device { color: var(--action); font-size: 24rpx; font-weight: 600; }
.session-revoke,
.code-button {
  flex: 0 0 auto;
  width: auto;
  min-height: 66rpx;
  padding: 0 20rpx;
  margin: 0;
  color: var(--action);
  background: var(--action-soft);
  border-radius: var(--radius-control);
  font-size: 24rpx;
  line-height: 1;
}
.session-empty { padding: 28rpx 0 10rpx; color: var(--muted); font-size: 26rpx; }
.phone-form { padding-left: 98rpx; }
.code-row { display: flex; align-items: center; gap: 14rpx; }
.code-row .code-field { min-width: 0; flex: 1; }
.code-button { min-height: 88rpx; margin-bottom: 18rpx; }

.archive-card { padding: 0 28rpx 28rpx; }
.archive-action { min-height: 112rpx; }
.archive-action .row-title { white-space: nowrap; }
.archive-description { display: block; color: var(--muted); font-size: 26rpx; line-height: 1.6; }
.logout-card { margin-top: 0; }
.danger-row .row-title { color: var(--danger); }
.round-icon-danger { color: var(--danger); background: var(--danger-soft); }

.profile-info-strip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
  color: var(--ink);
  background: #EDF7F3;
  border-radius: var(--radius-control);
  font-size: 26rpx;
  line-height: 1.5;
}
.profile-info-icon { flex: 0 0 auto; color: var(--ink); }

@media (min-width: 700px) {
  .profile-page { padding-left: 40rpx; padding-right: 40rpx; }
}
