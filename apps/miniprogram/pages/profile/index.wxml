<view class="profile-page">
  <view wx:if="{{loading}}" class="state-panel profile-state">
    <view class="state-icon"><t-loading size="48rpx" /></view><text class="state-title">正在加载个人信息</text><text class="state-copy">正在读取档案、权限和证书，请稍候。</text>
  </view>
  <view wx:elif="{{loadError}}" class="state-panel state-error profile-state">
    <view class="state-icon"><t-icon name="error-circle" size="48rpx" /></view><text class="state-title">个人信息加载失败</text><text class="state-copy">{{loadError}}</text><button class="secondary retry-button" bindtap="load">重新加载</button>
  </view>

  <block wx:else>
    <view wx:if="{{person}}" class="profile-card profile-summary" bindtap="openProfileDetail" hover-class="tap-active">
      <view class="avatar-wrap" catchtap="choosePhoto" aria-role="button" aria-label="点击照片修改个人照片">
        <image wx:if="{{photoPath}}" class="profile-avatar" src="{{photoPath}}" mode="aspectFill" />
        <view wx:else class="profile-avatar avatar-placeholder"><t-icon name="user" size="52rpx" /></view>
        <view class="photo-hint"><t-icon name="camera" size="25rpx" /></view>
      </view>
      <view class="identity-main">
        <view class="identity-title-line"><text class="identity-name">{{person.name}}</text><text class="type-pill">{{person.typeText}}</text></view>
        <text class="identity-organization">{{person.organizationText}}</text>
        <text class="identity-phone">{{security.verifiedPhoneMasked || person.phoneMasked}}</text>
      </view>
      <t-icon class="row-chevron" name="chevron-right" size="36rpx" />
    </view>

    <view wx:if="{{challengePoints}}" class="points-card" bindtap="openPoints" hover-class="tap-active">
      <view class="card-heading-button"><view class="round-icon points-icon"><t-icon name="star" size="38rpx" /></view><view class="heading-copy"><text class="card-heading">安全积分</text><text class="card-subtitle">积分来自每日安全挑战</text></view><t-icon class="row-chevron" name="chevron-right" size="36rpx" /></view>
      <view class="points-panel"><view class="points-column"><text class="points-value">{{challengePoints.total}}</text><text class="points-label">累计积分</text></view><view class="points-column"><text class="points-value">{{challengePoints.monthPoints}}</text><text class="points-label">本月积分</text></view><view class="points-column"><text class="points-value">{{challengePoints.rank || '—'}}</text><text class="points-label">本月排名</text></view></view>
    </view>

    <view class="profile-card single-link" bindtap="openCredentials" hover-class="tap-active">
      <view class="round-icon"><t-icon name="certificate" size="38rpx" /></view><view class="row-copy"><text class="row-title">证书与授权</text><text class="row-subtitle">{{certificates.length}} 项证书 · {{security && security.roles.length ? security.roles.length + ' 项管理角色' : '普通人员'}}</text></view><t-icon class="row-chevron" name="chevron-right" size="36rpx" />
    </view>

    <text class="profile-section-title">资料与服务</text>
    <view class="profile-card service-grid">
      <view class="service-item" bindtap="openProfileDetail" hover-class="tap-active"><view class="round-icon"><t-icon name="user" size="34rpx" /></view><text>个人资料</text><t-icon name="chevron-right" size="29rpx" /></view>
      <view class="service-item" bindtap="toggleTransferForm" hover-class="tap-active"><view class="round-icon"><t-icon name="swap" size="34rpx" /></view><text>申请调换部门</text><t-icon name="chevron-right" size="29rpx" /></view>
      <view class="service-item" bindtap="changeRequest" hover-class="tap-active"><view class="round-icon"><t-icon name="file-paste" size="34rpx" /></view><text>资料与关系变更</text><t-icon name="chevron-right" size="29rpx" /></view>
      <view class="service-item" bindtap="subscribe" hover-class="tap-active"><view class="round-icon"><t-icon name="notification" size="34rpx" /></view><text>微信订阅提醒</text><t-icon name="chevron-right" size="29rpx" /></view>
    </view>

    <view wx:if="{{showTransferForm}}" class="profile-card transfer-card">
      <text class="card-heading">申请调换部门</text><text class="card-subtitle">提交后由目标部门负责人审核</text>
      <picker mode="selector" range="{{organizations}}" range-key="name" value="{{targetIndex}}" bindchange="chooseDepartment"><view class="field">{{targetIndex >= 0 ? organizations[targetIndex].name : '选择目标部门'}}</view></picker>
      <textarea class="field transfer-reason" value="{{transferReason}}" bindinput="setTransferReason" placeholder="填写调换原因" />
      <button class="primary" bindtap="requestTransfer" loading="{{transferring}}">提交部门调换申请</button>
    </view>

    <view class="profile-card action-list-card">
      <view class="profile-list-row" bindtap="openAccountSecurity" hover-class="tap-active"><view class="round-icon"><t-icon name="secured" size="36rpx" /></view><view class="row-copy"><text class="row-title">账号与设备</text><text class="row-subtitle">登录方式、手机号和有效设备</text></view><t-icon class="row-chevron" name="chevron-right" size="36rpx" /></view>
      <view wx:if="{{canManage}}" class="list-divider"></view>
      <view wx:if="{{canManage}}" class="profile-list-row" bindtap="manage" hover-class="tap-active"><view class="round-icon"><t-icon name="task" size="36rpx" /></view><view class="row-copy"><text class="row-title">培训管理</text><text class="row-subtitle">审核、催办、解锁与项目确认</text></view><t-icon class="row-chevron" name="chevron-right" size="36rpx" /></view>
      <view class="list-divider"></view>
      <view class="profile-list-row" bindtap="exportMyArchive" hover-class="tap-active"><view class="round-icon"><t-loading wx:if="{{exporting}}" size="34rpx" /><t-icon wx:else name="file-paste" size="36rpx" /></view><view class="row-copy"><text class="row-title">下载本人资料</text><text class="row-subtitle">限时生成，仅可读取一次</text></view><t-icon class="row-chevron" name="chevron-right" size="36rpx" /></view>
    </view>

    <button class="logout-button" bindtap="logout">退出登录</button>
  </block>
</view>
<environment-badge />
