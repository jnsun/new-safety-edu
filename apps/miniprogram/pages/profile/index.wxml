<view class="page"><view class="card"><text class="title">个人信息</text><block wx:if="{{person}}"><view class="photo-wrap"><image wx:if="{{photoPath}}" class="photo" src="{{photoPath}}" mode="aspectFill"/><view wx:else class="photo placeholder">暂无照片</view><button class="mini-button" bindtap="choosePhoto">修改照片</button></view><view class="row"><text>姓名</text><text>{{person.name}}</text></view><view class="row"><text>人员类型</text><text>{{person.typeText}}</text></view><view class="row"><text>手机号</text><text>{{person.phone}}</text></view><view class="row"><text>身份证</text><text>{{person.nationalId || '待补录'}}</text></view><view class="row"><text>所属组织</text><text>{{person.organizationText}}</text></view><text class="hint">手机号修改需要短信验证，待短信服务配置后开放。</text></block><text wx:else class="muted">人员档案尚未绑定或正在审核。</text></view><view wx:if="{{person}}" class="card"><text class="title">申请调换部门</text><picker mode="selector" range="{{organizations}}" range-key="name" value="{{targetIndex}}" bindchange="chooseDepartment"><view class="field">{{targetIndex >= 0 ? organizations[targetIndex].name : '选择目标部门'}}</view></picker><textarea class="field" value="{{transferReason}}" bindinput="setTransferReason" placeholder="填写调换原因"/><button class="primary" bindtap="requestTransfer" loading="{{transferring}}">提交部门负责人审批</button></view><view class="card"><text class="title">我的</text><text class="muted">账号绑定、提醒和培训管理入口</text><button wx:if="{{canManage}}" class="primary" bindtap="manage">培训管理</button><button class="secondary" bindtap="subscribe">开启培训提醒</button><button class="secondary" bindtap="changeRequest">其他资料/绑定变更申请</button><button class="secondary logout" bindtap="logout">退出登录</button></view></view>
