<view class="page todo-page">
  <view class="welcome-row">
    <view class="welcome-copy">
      <text class="welcome-title">{{greeting}}{{person && person.name ? '，' + person.name : ''}}</text>
      <text class="welcome-subtitle">今天也要平安工作</text>
    </view>
    <image wx:if="{{photoPath}}" class="welcome-avatar" src="{{photoPath}}" mode="aspectFill" />
    <view wx:else class="welcome-avatar welcome-avatar-empty"><t-icon name="user" size="42rpx" /></view>
  </view>

  <view class="workspace-head">
    <text class="workspace-title">我的待办</text>
    <text wx:if="{{totalTasks}}" class="workspace-count">{{totalTasks}} 项未完成</text>
  </view>

  <view wx:if="{{loading}}" class="state-panel">
    <view class="state-icon"><t-loading size="48rpx" /></view>
    <text class="state-title">正在加载待办</text>
    <text class="state-copy">正在获取最新任务和进度，请稍候。</text>
  </view>

  <view wx:elif="{{error}}" class="state-panel state-error">
    <view class="state-icon"><t-icon name="error-circle" size="48rpx" /></view>
    <text class="state-title">待办加载失败</text>
    <text class="state-copy">{{error}}</text>
    <button class="secondary retry-button" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{!primaryTask}}" class="state-panel">
    <view class="state-icon"><t-icon name="check-circle" size="48rpx" /></view>
    <text class="state-title">当前没有待完成任务</text>
    <text class="state-copy">新的培训任务下发后会显示在这里。</text>
    <view class="empty-actions"><button class="primary" bindtap="openGames">去安全闯关</button><button class="secondary" bindtap="openRecords">查看培训记录</button></view>
  </view>

  <block wx:else>
    <view wx:if="{{primaryTask.isThreeLevelPriority && primaryTask.priorityReason}}" class="priority-banner">
      <view class="priority-icon"><t-icon name="flag" size="40rpx" /></view>
      <view class="priority-body"><text class="priority-copy">{{primaryTask.priorityReason}}</text><text class="priority-detail">这是当前最优先的培训任务，不影响你查看其他任务。</text></view>
    </view>

    <view class="todo-layout">
      <view class="primary-section">
        <text class="section-title">现在先做</text>
        <view class="primary-task" aria-role="button" hover-class="tap-active" data-id="{{primaryTask.id}}" bindtap="open">
          <view class="primary-badge">现在先做</view>
          <view class="task-heading">
            <text class="task-title">{{primaryTask.batch.name}}</text>
            <text class="primary-status">{{primaryTask.statusText}}</text>
          </view>
          <text class="task-meta">{{primaryTask.typeText}}</text>
          <text class="task-meta">截止时间：{{primaryTask.dueText}}</text>
          <view class="progress" aria-label="已完成 {{primaryTask.percent}}%">
            <view class="progress-bar" style="width: {{primaryTask.percent}}%"></view>
          </view>
          <view class="task-summary">
            <text>学习进度 {{primaryTask.progress.completed}}/{{primaryTask.progress.total}}</text>
          </view>
          <view class="next-step"><t-icon name="file-paste" size="31rpx" /><text>下一步：{{primaryTask.nextAction}}</text></view>
          <view class="enter-copy"><text>继续完成</text><t-icon name="chevron-right" size="32rpx" /></view>
        </view>
      </view>

      <view wx:if="{{remainingTasks.length}}" class="remaining-section">
        <view class="section-heading">
          <text class="section-title">其余任务</text>
          <text class="section-count">{{remainingTasks.length}} 项</text>
        </view>
        <view class="task-list">
          <view wx:for="{{remainingTasks}}" wx:key="id" class="task-row" aria-role="button" hover-class="tap-active" data-id="{{item.id}}" bindtap="open">
            <view class="task-row-main">
              <view class="task-heading">
                <text class="task-row-title">{{item.batch.name}}</text>
                <text class="status">{{item.statusText}}</text>
              </view>
              <text class="task-meta">{{item.typeText}} · 截止 {{item.dueText}}</text>
              <view class="compact-progress"><view style="width: {{item.percent}}%"></view></view>
            </view>
            <view class="row-action"><text>下一步：{{item.nextAction}}</text><t-icon name="chevron-right" size="28rpx" /></view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading && !error && challenge}}" class="challenge-section">
    <text class="section-title">每日安全挑战</text>
    <view class="challenge-card" aria-role="button" hover-class="tap-active" bindtap="openChallenge">
      <view class="challenge-icon"><t-icon name="lightbulb" size="42rpx" /></view>
      <view class="challenge-copy"><text class="challenge-title">{{challenge.completedAt ? '今日挑战已完成' : '用几分钟巩固安全判断'}}</text><text class="task-meta">已答 {{challenge.answeredCount}}/{{challenge.totalCount}} 题 · 今日 {{challenge.todayPoints}} 分</text></view>
      <view class="challenge-action"><text>{{challenge.completedAt ? '查看结果' : '开始挑战'}}</text><t-icon name="chevron-right" size="28rpx" /></view>
    </view>
    <text class="challenge-note">日常挑战为自愿巩固，不属于必须完成的培训任务。</text>
  </view>
</view>
<environment-badge />
