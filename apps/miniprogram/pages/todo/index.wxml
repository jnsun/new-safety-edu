<view class="page"><view class="hero"><text class="hero-title">我必须完成的任务</text><text>先完成这里的事项</text></view><view wx:if="{{loading}}" class="card empty">正在加载…</view><view wx:elif="{{error}}" class="card error">{{error}}</view><view wx:elif="{{!tasks.length}}" class="card empty">当前没有待完成任务</view><view wx:for="{{tasks}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="title">{{item.batch.name}}</text><text class="status">{{item.statusText}}</text></view><text class="muted">{{item.typeText}} · 截止 {{item.dueText}}</text><view class="progress"><view class="progress-bar" style="width: {{item.percent}}%"></view></view><view class="row"><text>{{item.progress.completed}}/{{item.progress.total}} 项已学</text><text class="success">下一步：{{item.nextAction}} ›</text></view></view></view>
