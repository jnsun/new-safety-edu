<view class="page"><text class="title">培训管理</text><text class="muted">只显示你有权管理的项目和人员</text><text wx:if="{{error}}" class="error">{{error}}</text><view class="card"><text class="subtitle">未完成人员</text><input class="field" placeholder="解锁前填写原因" bindinput="reason"/><view wx:for="{{assignments}}" wx:key="id" class="list-item"><view class="row"><text>{{item.person.name}} · {{item.batch.name}}</text><text class="status">{{item.statusText}}</text></view><text class="muted">进度 {{item.progress.completed}}/{{item.progress.total}} · 考试 {{item.attemptCount}} 次</text><view class="row"><button size="mini" data-id="{{item.id}}" bindtap="remind">催办</button><button wx:if="{{item.status === 'locked'}}" size="mini" data-id="{{item.id}}" bindtap="unlock">解锁</button><button wx:if="{{item.status === 'confirmation_pending'}}" size="mini" type="primary" data-id="{{item.id}}" bindtap="confirm">到场/交底确认</button></view></view></view><view class="card"><text class="subtitle">待审核申请</text><textarea class="field" placeholder="审核意见" bindinput="note"/><view wx:for="{{requests}}" wx:key="id" wx:for-index="index" class="list-item"><text>{{item.applicant}} · {{item.typeText}}</text><text class="muted">{{item.summary.reason || item.summary.phone || '关键关系/资料申请'}}</text><picker wx:if="{{item.type === 'binding'}}" range="{{persons}}" range-key="name" data-index="{{index}}" bindchange="choosePerson"><view class="field">{{item.personName || '选择人员档案'}}</view></picker><view class="row"><button size="mini" type="primary" data-index="{{index}}" data-decision="approve" bindtap="review">通过</button><button size="mini" data-index="{{index}}" data-decision="reject" bindtap="review">驳回</button></view></view></view></view>
