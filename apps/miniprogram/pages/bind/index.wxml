<view class="page"><view class="card"><text class="title">人员身份确认与微信绑定</text><text class="muted">手机号仅用于本次真实性验证。唯一匹配本人档案和部门时直接绑定，否则提交所选部门管理员审核。</text><text class="label">本人手机号</text><input class="field" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="setPhone"/><view class="code-row"><input class="field code-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{code}}" bindinput="setCode"/><button class="secondary code-button" loading="{{sending}}" disabled="{{countdown > 0}}" bindtap="sendCode">{{countdown > 0 ? countdown + ' 秒' : '获取验证码'}}</button></view><text class="label">姓名</text><input class="field" maxlength="80" placeholder="请输入真实姓名" value="{{name}}" bindinput="setName"/><text class="label">所属部门</text><picker range="{{departments}}" range-key="name" bindchange="chooseDepartment"><view class="field">{{departmentIndex >= 0 ? departments[departmentIndex].name : '请选择部门'}}</view></picker><text class="label">情况说明（选填）</text><textarea class="field" maxlength="500" placeholder="例如：档案手机号或部门信息已变更" value="{{reason}}" bindinput="setReason"/><button class="primary" loading="{{busy}}" bindtap="submit">验证并继续</button><text wx:if="{{error}}" class="error">{{error}}</text></view></view>
