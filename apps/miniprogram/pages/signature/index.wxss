.sign-box { position: relative; height: 420rpx; overflow: hidden; border: 2rpx solid #d2d2d7; border-radius: 28rpx; background: #fff; box-shadow: inset 0 1rpx 4rpx rgba(0, 0, 0, .04); }
canvas { width: 100%; height: 100%; }
.hint { position: absolute; left: 0; right: 0; top: 185rpx; text-align: center; color: #86868b; pointer-events: none; }
.half { width: 48%; margin: 18rpx 0 0; }
