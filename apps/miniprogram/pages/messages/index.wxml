<view class="page"><text class="title">消息中心</text><text wx:if="{{error}}" class="error">{{error}}</text><view wx:if="{{!messages.length}}" class="card empty">暂无消息</view><view wx:for="{{messages}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="read"><view class="row"><text class="subtitle">{{item.title}}</text><text class="status">{{item.status === 'unread' ? '未读' : '已读'}}</text></view><text class="muted">{{item.body}}</text><text class="muted">{{item.createdAt}}</text></view></view>
<environment-badge />
