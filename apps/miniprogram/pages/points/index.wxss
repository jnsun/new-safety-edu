.points-page{max-width:900rpx;margin:0 auto}.points-hero{padding:38rpx 34rpx;margin-bottom:26rpx;color:#fff;background:var(--action);border-radius:40rpx;box-shadow:0 20rpx 46rpx rgba(8,103,198,.18)}.hero-label,.hero-value{display:block}.hero-label{color:rgba(255,255,255,.78);font-size:27rpx}.hero-value{margin-top:8rpx;font-size:76rpx;font-weight:750}.hero-row{display:flex;justify-content:space-between;margin-top:24rpx;font-size:27rpx}.points-number{display:block;margin:22rpx 0;color:var(--action);font-size:68rpx;font-weight:750}.rules{padding-top:14rpx}.rule-row{display:flex;align-items:flex-start;gap:18rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line);font-size:29rpx;line-height:1.6}.rule-row:last-child{border-bottom:0}.rule-number{display:flex;flex:0 0 48rpx;height:48rpx;align-items:center;justify-content:center;color:var(--action);background:var(--action-soft);border-radius:14rpx;font-weight:700}
