<view class="page"><form bindsubmit="submit"><view class="card"><text class="title">资料与关系变更申请</text><radio-group bindchange="chooseType"><label><radio value="profile_change" checked="{{type === 'profile_change'}}"/>姓名修改</label><label><radio value="binding_change" checked="{{type === 'binding_change'}}"/>微信换绑</label><label><radio value="identity_correction" checked="{{type === 'identity_correction'}}"/>身份更正</label><label><radio value="contractor_unit_change" checked="{{type === 'contractor_unit_change'}}"/>外协单位变更</label><label><radio value="responsible_entity_change" checked="{{type === 'responsible_entity_change'}}"/>责任实体变更</label></radio-group><input wx:if="{{type === 'profile_change'}}" class="field" name="name" placeholder="新姓名"/><block wx:if="{{type === 'identity_correction'}}"><picker range="{{personTypes}}" range-key="label" value="{{personTypeIndex}}" bindchange="choosePersonType"><view class="field">更正为：{{personTypes[personTypeIndex].label}}</view></picker></block><picker wx:if="{{type === 'responsible_entity_change' || (type === 'identity_correction' && personTypes[personTypeIndex].value !== 'employee')}}" range="{{businessEntities}}" range-key="name" value="{{organizationIndex}}" bindchange="chooseOrganization"><view class="field">责任经营实体：{{businessEntities[organizationIndex].name || '请选择'}}</view></picker><picker wx:if="{{type === 'contractor_unit_change' || (type === 'identity_correction' && personTypes[personTypeIndex].value === 'contractor')}}" range="{{contractors}}" range-key="name" value="{{contractorIndex}}" bindchange="chooseContractor"><view class="field">外协单位：{{contractors[contractorIndex].name || '请选择'}}</view></picker><button wx:if="{{type === 'identity_correction' || type === 'contractor_unit_change' || type === 'responsible_entity_change'}}" size="mini" bindtap="chooseAttachment">添加核验附件（已选 {{attachmentIds.length}}）</button><textarea class="field" name="reason" placeholder="说明变更原因"/><button class="primary" form-type="submit" loading="{{busy}}">提交审核</button><text class="muted">手机号修改需要短信验证；身份更正由公司管理员处理，关系变更由相应负责人处理。</text></view></form><view class="card"><text class="subtitle">我的申请</text><view wx:for="{{requests}}" wx:key="id" class="row"><text>{{item.typeText}} · {{item.statusText}}</text><text class="muted">{{item.reviewNote || ''}}</text><button wx:if="{{item.canWithdraw}}" size="mini" data-id="{{item.id}}" bindtap="withdraw">撤回申请</button></view></view></view>
