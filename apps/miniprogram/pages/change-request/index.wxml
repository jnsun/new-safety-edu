<view class="page"><form bindsubmit="submit"><view class="card"><text class="title">资料/绑定变更申请</text><radio-group bindchange="chooseType"><label><radio value="profile_change" checked="true"/>姓名修改</label><label><radio value="binding_change"/>微信换绑</label></radio-group><input wx:if="{{type === 'profile_change'}}" class="field" name="name" placeholder="新姓名"/><textarea class="field" name="reason" placeholder="说明变更原因"/><button class="primary" form-type="submit" loading="{{busy}}">提交审核</button><text class="muted">手机号修改需要短信验证，请在短信服务配置完成后使用。</text></view></form><view class="card"><text class="subtitle">我的申请</text><view wx:for="{{requests}}" wx:key="id" class="row"><text>{{item.typeText}} · {{item.statusText}}</text><text class="muted">{{item.reviewNote || ''}}</text></view></view></view>
