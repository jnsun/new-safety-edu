<view class="page login-page">
  <view class="login-brand"><text class="brand-org">山西物化院</text><text class="hero-title">安全学习</text><text class="login-detail">把安全要求，落实到每一天</text></view>
  <image class="login-hero-image" src="/assets/figma-v3/login-field-team.jpeg" mode="aspectFill" />
  <view class="login-actions">
    <block wx:if="{{wechatLoginEnabled}}"><button class="primary login-button" loading="{{busy}}" bindtap="login"><t-icon name="logo-wechat-stroke" size="36rpx" color="#ffffff" />微信一键登录</button><text class="login-privacy">登录即表示你已阅读并同意《隐私政策》和《用户协议》</text></block>
    <view wx:if="{{!wechatLoginEnabled}}" class="service-offline"><t-icon name="error-circle" size="38rpx" /><text>微信登录服务尚未配置，请联系管理员。</text></view>
    <text wx:if="{{error}}" class="error">{{error}}</text>
  </view>
</view>
<environment-badge />
