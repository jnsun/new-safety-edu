.error { display: block; color: #d92d20; margin-top: 20rpx; }
.login-page { display: flex; min-height: calc(100vh - 120rpx); flex-direction: column; justify-content: center; }
.login-brand { padding: 36rpx 8rpx 50rpx; text-align: center; }
.brand-mark { display: flex; width: 104rpx; height: 104rpx; margin: 0 auto 28rpx; align-items: center; justify-content: center; background: var(--action); border-radius: 28rpx; box-shadow: 0 16rpx 34rpx rgba(36,93,71,.2); }
.login-copy { display: block; max-width: 620rpx; margin: 16rpx auto 0; color: var(--action); font-size: 34rpx; line-height: 1.5; font-weight: 700; }
.login-detail { display: block; max-width: 620rpx; margin: 12rpx auto 0; color: var(--muted); font-size: 28rpx; line-height: 1.6; }
.login-card { padding: 36rpx; border: 1rpx solid var(--line); }
.login-card .primary { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.login-privacy { display: block; margin-top: 20rpx; color: var(--muted); font-size: 24rpx; text-align: center; }
.service-offline { display: flex; align-items: center; gap: 14rpx; padding: 22rpx; color: var(--danger); background: var(--danger-soft); border: 1rpx solid var(--danger); border-radius: var(--radius-control); font-size: 28rpx; line-height: 1.5; }
.code-row { display: flex; gap: 16rpx; align-items: center; }
.code-input { flex: 1; }
.code-button { width: 220rpx; margin: 0; }
