.detail-page{max-width:900rpx;margin:0 auto}.identity-card,.info-card{padding:32rpx;margin-bottom:24rpx;background:#fff;border:1rpx solid var(--line);border-radius:var(--radius-card);box-shadow:var(--elevation)}.identity-card{display:flex;align-items:center;gap:28rpx;border-top:8rpx solid var(--action)}.avatar{width:144rpx;height:144rpx;border-radius:50%;background:var(--action-soft)}.avatar-empty{display:flex;align-items:center;justify-content:center;color:var(--action)}.name,.type{display:block}.name{font-size:42rpx;font-weight:700}.type{margin-top:10rpx;color:var(--action)}.info-row{display:flex;justify-content:space-between;gap:30rpx;padding:24rpx 0;border-bottom:1rpx solid var(--line)}.info-row:last-child{border-bottom:0}.info-row text:first-child{color:var(--muted)}.info-row text:last-child{min-width:0;text-align:right}
