<view class="page task-page">
  <view wx:if="{{loading}}" class="state-panel">
    <view class="state-icon"><t-loading size="48rpx" /></view>
    <text class="state-title">正在加载培训任务</text>
    <text class="state-copy">正在获取最新进度和操作状态，请稍候。</text>
  </view>

  <view wx:elif="{{error}}" class="state-panel state-error">
    <view class="state-icon"><t-icon name="error-circle" size="48rpx" /></view>
    <text class="state-title">任务加载失败</text>
    <text class="state-copy">{{error}}</text>
    <button class="secondary retry-button" bindtap="retry">重新加载</button>
  </view>

  <block wx:elif="{{task}}">
    <view class="task-summary-panel">
      <view class="summary-heading">
        <view class="summary-title-group">
          <text class="task-title">{{task.batch.name}}</text>
          <text class="task-type">{{task.typeText}}</text>
        </view>
        <text class="status">{{task.statusText}}</text>
      </view>

      <view class="facts">
        <view class="fact-row"><text class="fact-label">适用范围</text><text class="fact-value">{{task.batch.project ? task.batch.project.name : (task.organization ? task.organization.name : '公司范围')}}</text></view>
        <view class="fact-row"><text class="fact-label">截止时间</text><text class="fact-value">{{task.dueText}}</text></view>
        <view class="fact-row"><text class="fact-label">整体进度</text><text class="fact-value">{{task.progress.completed}}/{{task.progress.total}} 项已学</text></view>
      </view>
      <view class="progress" aria-label="已完成 {{task.percent}}%"><view class="progress-bar" style="width: {{task.percent}}%"></view></view>

      <view class="action-zone">
        <text class="action-label">当前下一步</text>
        <text class="action-copy">{{task.nextAction}}</text>
        <button wx:if="{{primaryAction}}" class="primary primary-action" bindtap="runPrimaryAction">{{primaryAction.label}}</button>
      </view>

      <view wx:if="{{task.status === 'remediation_required'}}" class="status-note warning-note">本轮需重新完成全部课件后才能再次考试。</view>
      <view wx:if="{{task.status === 'locked'}}" class="status-note danger-note">考试次数已用完，任务已锁定。请联系所属部门或项目管理员解锁。</view>
      <view wx:if="{{task.status === 'confirmation_pending'}}" class="status-note warning-note">{{confirmationText}}</view>
      <view wx:if="{{task.status === 'completed'}}" class="status-note success-note">培训已完成，可在“我的记录”中查看。</view>
    </view>

    <view class="stage-panel">
      <view class="section-heading">
        <text class="section-title">任务阶段</text>
        <text class="section-copy">依次完成学习、考试、签字和完成确认。</text>
      </view>
      <view class="stage-list">
        <view wx:for="{{stageItems}}" wx:key="key" class="stage-item stage-{{item.state}}">
          <view class="stage-mark"><t-icon wx:if="{{item.state === 'done'}}" name="check" size="24rpx" /><text wx:else>{{index + 1}}</text></view>
          <text class="stage-label">{{item.label}}</text>
          <text class="stage-state">{{item.stateText}}</text>
        </view>
      </view>
    </view>

    <view class="detail-grid">
      <view class="section-panel course-panel">
        <view class="section-heading">
          <text class="section-title">必学课件</text>
          <text class="section-copy">已完成 {{task.progress.completed}}/{{task.progress.total}} 项，所有课件均可查看。</text>
        </view>
        <view wx:if="{{!task.coursewares.length}}" class="inline-empty">本任务没有需要在线学习的课件。</view>
        <view wx:for="{{task.coursewares}}" wx:key="progressId" class="course-row" data-version-id="{{item.versionId}}" bindtap="study" hover-class="tap-active" aria-role="button" aria-label="{{item.title}}，{{item.completedAt ? '已完成' : '未完成'}}">
          <view class="course-copy">
            <view class="course-number">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</view>
            <view class="course-text"><text class="course-title">{{item.title}}</text>
            <text class="course-meta">v{{item.version}} · {{item.type === 'rich_text' ? '图文' : 'HTML'}}</text>
            </view>
          </view>
          <view class="course-state">
            <text class="{{item.completedAt ? 'success' : 'warning'}}">{{item.completedAt ? '已完成' : '未完成'}}</text>
            <view class="course-link"><text>{{item.completedAt ? '再次查看' : '去学习'}}</text><t-icon name="chevron-right" size="26rpx" /></view>
          </view>
        </view>
      </view>

      <view class="section-panel result-panel">
        <view class="section-heading">
          <text class="section-title">考试与签字</text>
          <text class="section-copy">结果来自当前培训任务记录。</text>
        </view>
        <view class="result-row">
          <text class="fact-label">考试</text>
          <text class="result-value">{{examResultText}}</text>
        </view>
        <view class="result-row">
          <text class="fact-label">签字</text>
          <text class="result-value">{{signatureResultText}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
<environment-badge />
