<view class="page"><view wx:if="{{loading}}" class="card empty">正在加载…</view><view wx:elif="{{error}}" class="card error">{{error}}</view><block wx:elif="{{task}}"><view class="card"><view class="row"><text class="title">{{task.batch.name}}</text><text class="status">{{task.statusText}}</text></view><text class="muted">{{task.typeText}}</text><view class="divider"></view><view class="row"><text>适用范围</text><text>{{task.batch.project ? task.batch.project.name : (task.organization ? task.organization.name : '公司范围')}}</text></view><view class="row"><text>截止时间</text><text>{{task.dueText}}</text></view><view class="row"><text>当前下一步</text><text class="success">{{task.nextAction}}</text></view></view><view class="card"><text class="title">必学课件（{{task.progress.completed}}/{{task.progress.total}}）</text><text wx:if="{{task.status === 'remediation_required'}}" class="warning">本轮需重新完成全部课件后才能再次考试</text><view wx:for="{{task.coursewares}}" wx:key="progressId" class="course" data-version-id="{{item.versionId}}" bindtap="study"><view><text>{{index + 1}}. {{item.title}}</text><text class="muted small">v{{item.version}} · {{item.type === 'rich_text' ? '图文' : 'HTML'}}</text></view><text class="{{item.completedAt ? 'success' : 'warning'}}">{{item.completedAt ? '已完成' : '去学习 ›'}}</text></view></view><view class="card"><text class="title">考试与签字</text><view class="row"><text>考试</text><text>{{!task.batch.examRequired ? '本次不要求考试' : (task.latestAttempt ? (task.latestAttempt.passed ? task.latestAttempt.score + ' 分 · 通过' : task.latestAttempt.score + ' 分 · 未通过') : '尚未考试')}}</text></view><view class="row"><text>签字</text><text>{{task.signedAt ? '已签字' : '未签字'}}</text></view><button wx:if="{{task.status === 'pending_exam' || (task.status === 'remediation_required' && task.progress.completed === task.progress.total)}}" class="primary" bindtap="exam">{{task.latestAttempt ? '继续考试流程' : '开始考试'}}</button><view wx:if="{{task.status === 'locked'}}" class="locked">考试次数已用完，任务已锁定。请联系所属部门或项目管理员解锁。</view><button wx:if="{{task.status === 'pending_signature'}}" class="primary" bindtap="sign">查看记录并本人签字</button><text wx:if="{{task.status === 'confirmation_pending'}}" class="warning">已签字，等待项目管理员确认到场和现场交底。</text><text wx:if="{{task.status === 'completed'}}" class="success">培训已完成，可在“我的记录”中查看。</text></view></block></view>
