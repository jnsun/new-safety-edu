.course { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 26rpx 0; border-bottom: 1rpx solid rgba(0, 0, 0, .08); }
.course:last-child { border-bottom: 0; }
.small { display: block; font-size: 24rpx; margin-top: 8rpx; }
.locked { margin-top: 24rpx; padding: 24rpx; border-radius: 18rpx; color: #d70015; background: #fff0f1; }
