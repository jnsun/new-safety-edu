.task-page { max-width: 1100rpx; margin: 0 auto; }
.state-panel { padding: 54rpx 34rpx; background: var(--surface); border-radius: var(--radius-card); box-shadow: var(--elevation); text-align: center; }
.state-title { display: block; margin-bottom: 12rpx; font-size: 34rpx; line-height: 1.3; font-weight: 650; }
.state-copy, .section-copy { display: block; color: var(--muted); font-size: 28rpx; line-height: 1.55; }
.state-error .state-title { color: var(--danger); }
.retry-button { width: 100%; margin-top: 30rpx; }
.task-summary-panel, .stage-panel, .section-panel { padding: 32rpx; margin-bottom: 24rpx; background: var(--surface); border-radius: var(--radius-card); box-shadow: var(--elevation); }
.summary-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 22rpx; }
.summary-title-group { min-width: 0; flex: 1; }
.task-title { display: block; font-size: 40rpx; line-height: 1.28; font-weight: 700; letter-spacing: -1rpx; }
.task-type { display: block; margin-top: 10rpx; color: var(--muted); font-size: 28rpx; line-height: 1.5; }
.facts { margin-top: 28rpx; padding-top: 8rpx; border-top: 1rpx solid var(--line); }
.fact-row, .result-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 28rpx; min-height: 58rpx; padding: 14rpx 0; box-sizing: border-box; font-size: 28rpx; line-height: 1.5; }
.fact-label { flex: 0 0 auto; color: var(--muted); }
.fact-value, .result-value { min-width: 0; text-align: right; }
.action-zone { padding: 26rpx; margin-top: 26rpx; background: var(--action-soft); border-radius: var(--radius-control); }
.action-label { display: block; color: #123452; font-size: 28rpx; line-height: 1.4; }
.action-copy { display: block; margin-top: 6rpx; color: #123452; font-size: 36rpx; line-height: 1.3; font-weight: 700; }
.primary-action { width: 100%; margin-top: 22rpx; }
.status-note { margin-top: 22rpx; padding: 22rpx 24rpx; border-radius: 18rpx; font-size: 28rpx; line-height: 1.55; }
.warning-note { color: var(--warning); background: var(--canvas); }
.danger-note { color: var(--danger); background: var(--canvas); }
.success-note { color: var(--success); background: var(--canvas); }
.section-heading { margin-bottom: 24rpx; }
.section-title { display: block; margin-bottom: 8rpx; font-size: 34rpx; line-height: 1.35; font-weight: 650; }
.stage-list { display: flex; gap: 10rpx; }
.stage-item { min-width: 0; flex: 1; padding-top: 16rpx; border-top: 8rpx solid var(--line); }
.stage-mark { display: none; }
.stage-label, .stage-state { display: block; text-align: center; }
.stage-label { font-size: 28rpx; line-height: 1.4; font-weight: 650; }
.stage-state { margin-top: 5rpx; color: var(--muted); font-size: 28rpx; line-height: 1.35; }
.stage-current { border-top-color: var(--action); }
.stage-current .stage-state { color: var(--action); font-weight: 600; }
.stage-done { border-top-color: var(--success); }
.stage-done .stage-state { color: var(--success); font-weight: 600; }
.course-row { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; width: 100%; min-height: 108rpx; padding: 24rpx 0; margin: 0; box-sizing: border-box; color: var(--ink); background: var(--surface); border-bottom: 1rpx solid var(--line); border-radius: 0; text-align: left; line-height: 1.4; }
.course-row:last-child { border-bottom: 0; }
.course-copy { min-width: 0; flex: 1; }
.course-title { display: block; font-size: 30rpx; line-height: 1.45; font-weight: 600; }
.course-meta { display: block; margin-top: 8rpx; color: var(--muted); font-size: 28rpx; line-height: 1.4; }
.course-state { flex: 0 0 auto; text-align: right; font-size: 28rpx; line-height: 1.4; }
.course-state text { display: block; }
.course-link { margin-top: 5rpx; color: var(--action); font-weight: 600; }
.inline-empty { padding: 28rpx 0; color: var(--muted); font-size: 28rpx; line-height: 1.5; }
.result-row { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.result-row:last-child { border-bottom: 0; }

@media (min-width: 700px) {
  .task-page { max-width: 1320rpx; padding-left: 48rpx; padding-right: 48rpx; }
  .detail-grid { display: flex; align-items: flex-start; gap: 24rpx; }
  .course-panel { min-width: 0; flex: 1.12; }
  .result-panel { min-width: 0; flex: .88; }
}
