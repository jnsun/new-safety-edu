<view class="page">
  <view class="card">
    <text class="title">人员身份确认与微信绑定</text>
    <text class="status">{{statusText}}</text>
    <text wx:if="{{status === 'pending'}}" class="muted">手机号已经验证。审核前不会获得人员身份或任何管理权限。</text>
    <text wx:if="{{reviewNote}}" class="muted">审核意见：{{reviewNote}}</text>
    <text wx:if="{{error}}" class="error">{{error}}</text>
    <button wx:if="{{canEnter}}" class="primary" bindtap="enter">进入我的待办</button>
    <button wx:else class="primary" loading="{{busy}}" bindtap="refresh">刷新审核状态</button>
    <button class="secondary" bindtap="back">退出并切换微信</button>
  </view>
</view>
<environment-badge />
