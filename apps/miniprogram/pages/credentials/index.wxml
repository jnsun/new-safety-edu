<view class="page credential-page"><view wx:if="{{loading}}" class="state-panel"><view class="state-icon"><t-loading size="48rpx"/></view><text class="state-title">正在加载证书与授权</text></view><view wx:elif="{{error}}" class="state-panel state-error"><text class="state-title">加载失败</text><text class="state-copy">{{error}}</text><button class="secondary" bindtap="load">重新加载</button></view><block wx:else><text class="section-title">人员证书</text><view wx:if="{{!certificates.length}}" class="state-panel compact">暂无证书记录</view><view wx:for="{{certificates}}" wx:key="id" class="credential-card"><view class="card-head"><t-icon name="certificate" size="42rpx"/><text>{{item.displayName}}</text></view><view class="info-row"><text>证书编号</text><text>{{item.displayNumber}}</text></view><view class="info-row"><text>到期时间</text><text>{{item.expiresText}}</text></view></view><text class="section-title role-title">当前管理角色</text><view wx:if="{{!roles.length}}" class="credential-card"><text>普通人员</text><text class="muted">本人资料与培训范围</text></view><view wx:for="{{roles}}" wx:key="id" class="credential-card"><text class="role-name">{{item.nameText}}</text><text class="muted">{{item.scopeText}}</text></view></block></view><environment-badge />
