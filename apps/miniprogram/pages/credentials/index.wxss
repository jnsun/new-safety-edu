.credential-page{max-width:900rpx;margin:0 auto}.section-title{margin:8rpx 4rpx 18rpx}.role-title{margin-top:34rpx}.credential-card{padding:30rpx;margin-bottom:20rpx;background:#fff;border:1rpx solid var(--line);border-radius:var(--radius-card);box-shadow:var(--elevation)}.card-head{display:flex;align-items:center;gap:16rpx;color:var(--action);font-size:32rpx;font-weight:700}.info-row{display:flex;justify-content:space-between;gap:24rpx;padding-top:22rpx;margin-top:22rpx;border-top:1rpx solid var(--line);font-size:28rpx}.info-row text:first-child{color:var(--muted)}.role-name{display:block;font-size:31rpx;font-weight:700}.compact{padding:42rpx}
