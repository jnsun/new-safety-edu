page {
  --canvas: #f5f5f7;
  --surface: #ffffff;
  --ink: #1d1d1f;
  --muted: #6e6e73;
  --action: #0071e3;
  --action-soft: #e8f2ff;
  --success: #248a3d;
  --warning: #9a5200;
  --danger: #c40016;
  --line: #d9d9de;
  --radius-card: 28rpx;
  --radius-control: 22rpx;
  --elevation: 0 12rpx 38rpx rgba(0, 0, 0, .055);
  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-size: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif;
}
.page { min-height: 100vh; padding: 32rpx 28rpx calc(56rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.hero {
  padding: 44rpx 36rpx; margin-bottom: 24rpx; color: var(--ink); background: var(--surface);
  border-radius: var(--radius-card); box-shadow: var(--elevation);
}
.hero-title { display: block; max-width: 560rpx; margin-bottom: 14rpx; font-size: 46rpx; line-height: 1.16; font-weight: 700; letter-spacing: -1rpx; }
.card {
  background: var(--surface); border-radius: var(--radius-card);
  padding: 32rpx; margin-bottom: 22rpx; box-shadow: var(--elevation);
}
.title { display: block; min-width: 0; margin-bottom: 12rpx; color: var(--ink); font-size: 36rpx; line-height: 1.25; font-weight: 650; letter-spacing: -1rpx; }
.subtitle { display: block; margin-bottom: 16rpx; color: var(--ink); font-size: 31rpx; font-weight: 600; }
.muted { display: block; color: var(--muted); font-size: 28rpx; line-height: 1.55; }
button { font-size: 29rpx; font-weight: 550; }
button::after { border: 0; }
.primary, .secondary { min-height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-control); margin-top: 24rpx; line-height: 1.2; }
.primary { color: #fff !important; background: var(--action) !important; }
.primary[disabled] { color: #fff !important; background: var(--action) !important; opacity: .45; }
.secondary { color: #0066cc !important; background: var(--surface) !important; border: 2rpx solid var(--line); }
.secondary[disabled] { color: var(--muted) !important; background: var(--canvas) !important; border-color: var(--line); opacity: .65; }
.field {
  min-height: 88rpx; padding: 22rpx 24rpx; margin: 12rpx 0 22rpx; box-sizing: border-box;
  color: var(--ink); background: var(--canvas); border: 2rpx solid transparent; border-radius: 18rpx;
}
textarea.field { width: 100%; min-height: 180rpx; }
.label { color: #424245; font-size: 28rpx; font-weight: 550; }
.empty { padding: 90rpx 28rpx; text-align: center; color: var(--muted); }
.row { display: flex; justify-content: space-between; align-items: center; gap: 22rpx; margin: 16rpx 0; }
.row > text:first-child { min-width: 0; }
.status { display: inline-block; flex: 0 0 auto; padding: 7rpx 14rpx; border-radius: 12rpx; color: #0066cc; background: var(--action-soft); font-size: 28rpx; font-weight: 550; }
.progress { height: 12rpx; overflow: hidden; border-radius: 12rpx; background: var(--line); margin: 24rpx 0; }
.progress-bar { height: 100%; border-radius: 12rpx; background: var(--action); }
.error { display: block; color: var(--danger); margin-top: 18rpx; }
.success { color: var(--success); font-weight: 550; }
.warning { color: var(--warning); font-weight: 550; }
.divider { height: 1rpx; background: var(--line); margin: 26rpx 0; }
.dev-label { display: block; margin-top: 34rpx; }
button[size="mini"] { min-width: 128rpx; margin: 10rpx 12rpx 0 0; padding: 0 24rpx; color: #0066cc; background: #f1f7ff; border-radius: 18rpx; font-size: 28rpx; }
button[size="mini"][type="primary"] { color: #fff; background: var(--action); }
radio-group label, checkbox-group label { color: #424245; }
