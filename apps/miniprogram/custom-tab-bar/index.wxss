.tab-shell { position: fixed; z-index: 1000; left: 0; right: 0; bottom: 0; display: flex; min-height: 96rpx; padding: 12rpx 14rpx calc(10rpx + env(safe-area-inset-bottom)); box-sizing: content-box; background: rgba(255,255,255,.98); border-top: 1rpx solid #E4E7EB; box-shadow: 0 -8rpx 28rpx rgba(17,24,39,.04); }
.tab-item { flex: 1; display: flex; min-width: 0; align-items: center; justify-content: center; flex-direction: column; gap: 2rpx; color: #7E858F; font-size: 22rpx; line-height: 1.2; }
.tab-icon { display: flex; width: 64rpx; height: 50rpx; align-items: center; justify-content: center; border-radius: 22rpx; }
.tab-item-active { color: #087BE8; font-weight: 700; }
.tab-item-active .tab-icon { background: transparent; }
