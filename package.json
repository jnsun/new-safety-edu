{
  "name": "wuhuayuan-safety-education",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "pnpm --filter @safety/contracts build && pnpm --parallel --filter @safety/api --filter @safety/admin dev",
    "dev:api": "pnpm --filter @safety/api dev",
    "dev:admin": "pnpm --filter @safety/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @safety/contracts build && pnpm -r typecheck",
    "check:miniprogram": "node scripts/check-miniprogram-production.mjs",
    "check:person-import": "pnpm --filter @safety/api check:person-import",
    "check:phase1-invariants": "pnpm --filter @safety/api check:phase1-invariants",
    "check:phase1-policy": "pnpm --filter @safety/api check:phase1-policy",
    "check:phases2-7": "pnpm --filter @safety/api check:phases2-7",
    "check:account-password-reset": "pnpm --filter @safety/api check:account-password-reset",
    "check:account-lifecycle": "pnpm --filter @safety/api check:account-lifecycle",
    "check:person-account-domain-model": "pnpm --filter @safety/api check:person-account-domain-model",
    "check:person-role-contract": "pnpm --filter @safety/api check:person-role-contract",
    "check:session-login-policy": "pnpm --filter @safety/api check:session-login-policy",
    "check:account-merge-policy": "pnpm --filter @safety/api check:account-merge-policy",
    "smoke:phase1-identity": "tsx scripts/phase1-identity-smoke.ts",
    "smoke:phase1-api": "tsx scripts/phase1-api-smoke.mts",
    "smoke:account-lifecycle": "pnpm --filter @safety/api smoke:account-lifecycle",
    "smoke:person-role": "pnpm --filter @safety/api smoke:person-role",
    "smoke:phases2-4-api": "tsx scripts/phases2-4-api-smoke.mts",
    "prisma:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap": "tsx prisma/seed.ts"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prisma": "^6.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
