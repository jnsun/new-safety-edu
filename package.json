{
  "name": "wuhuayuan-safety-education",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "pnpm --filter @safety/contracts build && pnpm --parallel --filter @safety/api --filter @safety/admin dev",
    "dev:api": "pnpm --filter @safety/api dev",
    "dev:admin": "pnpm --filter @safety/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @safety/contracts build && pnpm -r typecheck",
    "check:miniprogram": "node scripts/check-miniprogram-production.mjs",
    "prisma:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap": "tsx prisma/seed.ts"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prisma": "^6.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
