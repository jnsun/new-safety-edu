# development | production | test
NODE_ENV=
# API listening port
PORT=
# Public HTTPS origin, without trailing slash
PUBLIC_BASE_URL=
# PostgreSQL connection string
DATABASE_URL=
# At least 32 random characters
COOKIE_SECRET=
# At least 32 random characters
JWT_SECRET=
# Base64-encoded 32-byte AES-256 key
FIELD_ENCRYPTION_KEY=
# Private persistent upload directory
UPLOAD_ROOT=
# At least 32 random characters for short-lived file URLs
UPLOAD_SIGNING_SECRET=
# WeChat Mini Program credentials; backend only
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional approved subscription-message template IDs
WECHAT_SUBSCRIBE_TEMPLATE_TASK=
WECHAT_SUBSCRIBE_TEMPLATE_DUE=
# Template field names from the approved WeChat templates
WECHAT_SUBSCRIBE_FIELD_TITLE=thing1
WECHAT_SUBSCRIBE_FIELD_BODY=thing2
# Optional server-side SMS gateway. It receives { phone, code, purpose } via HTTPS POST.
SMS_SEND_ENDPOINT=
SMS_SEND_TOKEN=
# Optional WeChat Open Platform Website Application credentials; backend only
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=
# One-time first administrator bootstrap values
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
