generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  pending
  active
  disabled
}

enum PersonType {
  employee
  contractor
  temporary_individual
}

enum PersonStatus {
  pending
  active
  disabled
}

enum OrganizationType {
  company
  business_entity
  department
  contractor
}

enum RoleName {
  company_admin
  org_leader
  org_admin
  field_reporter
  project_admin
  learner
}

enum ScopeType {
  company
  organization
  project
  person
}

enum ProjectStatus {
  active
  paused
  ended
}

enum MembershipStatus {
  pending
  active
  rejected
  removed
}

enum FileKind {
  photo
  signature
  courseware
  attachment
}

enum CoursewareType {
  rich_text
  single_html
}

enum PublishStatus {
  draft
  published
  retired
}

enum TrainingType {
  three_level
  project_induction
  routine
  change_update
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
}

enum PaperMode {
  fixed
  random
}

enum BatchSource {
  online
  offline
  reconfirmation
}

enum AssignmentStatus {
  pending_learning
  learning
  pending_exam
  remediation_required
  locked
  pending_signature
  confirmation_pending
  completed
  cancelled
}

enum AttemptStatus {
  in_progress
  submitted
  expired
}

enum NotificationStatus {
  unread
  read
}

enum ChangeRequestType {
  binding
  profile_change
  registration
  binding_change
  department_transfer
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
  duplicate
  cancelled
}

enum OutboxStatus {
  pending
  sent
  skipped
  failed
}

enum MonthlyReportStatus {
  draft
  submitted
}

enum ReportProjectStatus {
  active
  completed
}

enum ReportFieldType {
  text
  number
  textarea
  select
  date
}

enum CertificateCategory {
  company
  personal
}

enum CertificateLifecycleStatus {
  active
  replaced
  revoked
}

enum CertificateTrainingStatus {
  trained
  not_required
  pending
}

model Account {
  id              String           @id @default(uuid()) @db.Uuid
  username        String?          @unique @db.VarChar(80)
  passwordHash    String?          @map("password_hash")
  status          AccountStatus    @default(active)
  sessionVersion  Int              @default(0) @map("session_version")
  personId        String?          @unique @map("person_id") @db.Uuid
  verifiedPhone   String?          @unique @map("verified_phone") @db.VarChar(20)
  person          Person?          @relation(fields: [personId], references: [id])
  roles           RoleAssignment[]
  wechatBindings  WechatBinding[]
  refreshSessions RefreshSession[]
  preferences     UserPreference[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("accounts")
}

model Person {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(80)
  phone              String                   @db.VarChar(20)
  type               PersonType
  status             PersonStatus             @default(pending)
  nationalIdCipher   String?                  @map("national_id_cipher")
  nationalIdIv       String?                  @map("national_id_iv")
  nationalIdTag      String?                  @map("national_id_tag")
  nationalIdHash     String?                  @map("national_id_hash") @db.VarChar(64)
  nationalIdLast4    String?                  @map("national_id_last4") @db.Char(4)
  photoFileId        String?                  @map("photo_file_id") @db.Uuid
  photoFile          PrivateFile?             @relation("PersonPhoto", fields: [photoFileId], references: [id])
  account            Account?
  organizations      OrganizationMembership[]
  projectMemberships ProjectMember[]
  assignments        TrainingAssignment[]
  signatures         Signature[]
  changeRequests     ChangeRequest[]
  notifications      Notification[]
  certificates       PersonCertificate[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@unique([nationalIdHash])
  @@index([phone, status])
  @@map("persons")
}

model WechatBinding {
  id        String    @id @default(uuid()) @db.Uuid
  appId     String    @map("app_id") @db.VarChar(64)
  openid    String    @db.VarChar(128)
  unionid   String?   @db.VarChar(128)
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id])
  active    Boolean   @default(true)
  boundAt   DateTime? @map("bound_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([appId, openid])
  @@map("wechat_bindings")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("refresh_sessions")
}

model Organization {
  id                      String                      @id @default(uuid()) @db.Uuid
  name                    String                      @db.VarChar(120)
  type                    OrganizationType
  parentId                String?                     @map("parent_id") @db.Uuid
  reportingEnabled        Boolean                     @default(false) @map("reporting_enabled")
  parent                  Organization?               @relation("OrganizationTree", fields: [parentId], references: [id])
  children                Organization[]              @relation("OrganizationTree")
  memberships             OrganizationMembership[]
  projects                Project[]
  qualifications          OrganizationQualification[]
  monthlyReports          ProjectMonthlyReport[]
  departmentMonthStatuses DepartmentMonthStatus[]
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")

  @@unique([parentId, name])
  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  personId       String       @map("person_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  person         Person       @relation(fields: [personId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  primary        Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([personId, organizationId])
  @@map("organization_memberships")
}

model RoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      RoleName
  scopeType ScopeType @map("scope_type")
  scopeId   String?   @map("scope_id") @db.Uuid
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([accountId, role, scopeType, scopeId])
  @@index([role, scopeType, scopeId, active])
  @@map("role_assignments")
}

model Project {
  id                        String                 @id @default(uuid()) @db.Uuid
  name                      String                 @db.VarChar(160)
  code                      String                 @unique @db.VarChar(50)
  responsibleOrganizationId String                 @map("responsible_organization_id") @db.Uuid
  responsibleOrganization   Organization           @relation(fields: [responsibleOrganizationId], references: [id])
  status                    ProjectStatus          @default(active)
  members                   ProjectMember[]
  batches                   TrainingBatch[]
  monthlyReports            ProjectMonthlyReport[]
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMember {
  id         String           @id @default(uuid()) @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  personId   String           @map("person_id") @db.Uuid
  project    Project          @relation(fields: [projectId], references: [id])
  person     Person           @relation(fields: [personId], references: [id])
  status     MembershipStatus @default(pending)
  reviewedBy String?          @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?        @map("reviewed_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([projectId, personId])
  @@map("project_members")
}

model PrivateFile {
  id                         String                      @id @default(uuid()) @db.Uuid
  kind                       FileKind
  storageKey                 String                      @unique @map("storage_key")
  originalName               String                      @map("original_name")
  mimeType                   String                      @map("mime_type")
  size                       Int
  sha256                     String                      @db.VarChar(64)
  uploadedBy                 String                      @map("uploaded_by") @db.Uuid
  personPhotos               Person[]                    @relation("PersonPhoto")
  versions                   CoursewareVersion[]
  signatures                 Signature[]
  personCertificates         PersonCertificate[]
  organizationQualifications OrganizationQualification[]
  certificateAttachments     CertificateAttachment[]
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  @@map("files")
}

model PersonCertificate {
  id                  String                      @id @default(uuid()) @db.Uuid
  personId            String                      @map("person_id") @db.Uuid
  person              Person                      @relation(fields: [personId], references: [id])
  name                String                      @db.VarChar(160)
  category            String?                     @db.VarChar(80)
  typeId              String?                     @map("type_id") @db.Uuid
  type                CertificateType?            @relation(fields: [typeId], references: [id])
  subtype1Value       String?                     @map("subtype_1_value") @db.VarChar(120)
  subtype2Value       String?                     @map("subtype_2_value") @db.VarChar(120)
  certificateNoCipher String?                     @map("certificate_no_cipher")
  certificateNoIv     String?                     @map("certificate_no_iv")
  certificateNoTag    String?                     @map("certificate_no_tag")
  certificateNoLast4  String?                     @map("certificate_no_last4") @db.VarChar(8)
  issuingAuthority    String?                     @map("issuing_authority") @db.VarChar(160)
  issuedAt            DateTime?                   @map("issued_at") @db.Date
  validFrom           DateTime?                   @map("valid_from") @db.Date
  expiresAt           DateTime?                   @map("expires_at") @db.Date
  isLongTerm          Boolean                     @default(false) @map("is_long_term")
  holderPosition      String?                     @map("holder_position") @db.VarChar(120)
  status              CertificateLifecycleStatus  @default(active)
  trainingStatus      CertificateTrainingStatus?  @default(pending) @map("training_status")
  remark              String?                     @db.VarChar(2000)
  renewedFromId       String?                     @map("renewed_from_id") @db.Uuid
  renewedFrom         PersonCertificate?          @relation("PersonCertificateRenewal", fields: [renewedFromId], references: [id])
  renewals            PersonCertificate[]         @relation("PersonCertificateRenewal")
  renewedAt           DateTime?                   @map("renewed_at")
  createdBy           String?                     @map("created_by") @db.Uuid
  fileId              String?                     @map("file_id") @db.Uuid
  file                PrivateFile?                @relation(fields: [fileId], references: [id])
  attachments         CertificateAttachment[]
  trainingRecords     CertificateTrainingRecord[]
  active              Boolean                     @default(true)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@index([personId, active, expiresAt])
  @@map("person_certificates")
}

model OrganizationQualification {
  id                  String                      @id @default(uuid()) @db.Uuid
  organizationId      String                      @map("organization_id") @db.Uuid
  organization        Organization                @relation(fields: [organizationId], references: [id])
  name                String                      @db.VarChar(160)
  category            String?                     @db.VarChar(80)
  typeId              String?                     @map("type_id") @db.Uuid
  type                CertificateType?            @relation(fields: [typeId], references: [id])
  subtype1Value       String?                     @map("subtype_1_value") @db.VarChar(120)
  subtype2Value       String?                     @map("subtype_2_value") @db.VarChar(120)
  certificateNoCipher String?                     @map("certificate_no_cipher")
  certificateNoIv     String?                     @map("certificate_no_iv")
  certificateNoTag    String?                     @map("certificate_no_tag")
  certificateNoLast4  String?                     @map("certificate_no_last4") @db.VarChar(8)
  issuingAuthority    String?                     @map("issuing_authority") @db.VarChar(160)
  issuedAt            DateTime?                   @map("issued_at") @db.Date
  validFrom           DateTime?                   @map("valid_from") @db.Date
  expiresAt           DateTime?                   @map("expires_at") @db.Date
  isLongTerm          Boolean                     @default(false) @map("is_long_term")
  status              CertificateLifecycleStatus  @default(active)
  remark              String?                     @db.VarChar(2000)
  renewedFromId       String?                     @map("renewed_from_id") @db.Uuid
  renewedFrom         OrganizationQualification?  @relation("OrganizationQualificationRenewal", fields: [renewedFromId], references: [id])
  renewals            OrganizationQualification[] @relation("OrganizationQualificationRenewal")
  renewedAt           DateTime?                   @map("renewed_at")
  createdBy           String?                     @map("created_by") @db.Uuid
  scope               String?
  fileId              String?                     @map("file_id") @db.Uuid
  file                PrivateFile?                @relation(fields: [fileId], references: [id])
  attachments         CertificateAttachment[]
  active              Boolean                     @default(true)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@index([organizationId, active, expiresAt])
  @@map("organization_qualifications")
}

model CertificateType {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @unique @db.VarChar(160)
  category                   CertificateCategory
  subtype1Label              String?                     @map("subtype_1_label") @db.VarChar(80)
  subtype1Options            Json                        @default("[]") @map("subtype_1_options")
  subtype2Label              String?                     @map("subtype_2_label") @db.VarChar(80)
  subtype2Options            Json                        @default("[]") @map("subtype_2_options")
  sortOrder                  Int                         @default(0) @map("sort_order")
  active                     Boolean                     @default(true)
  personCertificates         PersonCertificate[]
  organizationQualifications OrganizationQualification[]
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  @@index([category, active, sortOrder])
  @@map("certificate_types")
}

model CertificateAttachment {
  id                          String                     @id @default(uuid()) @db.Uuid
  fileId                      String                     @map("file_id") @db.Uuid
  file                        PrivateFile                @relation(fields: [fileId], references: [id])
  personCertificateId         String?                    @map("person_certificate_id") @db.Uuid
  personCertificate           PersonCertificate?         @relation(fields: [personCertificateId], references: [id])
  organizationQualificationId String?                    @map("organization_qualification_id") @db.Uuid
  organizationQualification   OrganizationQualification? @relation(fields: [organizationQualificationId], references: [id])
  createdBy                   String                     @map("created_by") @db.Uuid
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")

  @@unique([fileId])
  @@map("certificate_attachments")
}

model CertificateTrainingRecord {
  id                   String            @id @default(uuid()) @db.Uuid
  personCertificateId  String            @map("person_certificate_id") @db.Uuid
  personCertificate    PersonCertificate @relation(fields: [personCertificateId], references: [id])
  year                 Int
  trainingDate         DateTime          @map("training_date") @db.Date
  content              String            @db.VarChar(1000)
  trainingOrganization String?           @map("training_organization") @db.VarChar(160)
  hours                Decimal?          @db.Decimal(6, 2)
  result               String?           @db.VarChar(120)
  remark               String?           @db.VarChar(1000)
  createdBy            String            @map("created_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@index([personCertificateId, year])
  @@map("certificate_training_records")
}

model CertificateSetting {
  id        String   @id @default("default") @db.VarChar(32)
  warnDays  Int      @default(90) @map("warn_days")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("certificate_settings")
}

model ProjectMonthlyReport {
  id                        String              @id @default(uuid()) @db.Uuid
  projectId                 String              @map("project_id") @db.Uuid
  project                   Project             @relation(fields: [projectId], references: [id])
  reportingOrganizationId   String              @map("reporting_organization_id") @db.Uuid
  reportingOrganization     Organization        @relation(fields: [reportingOrganizationId], references: [id])
  reportMonth               DateTime            @map("report_month") @db.Date
  status                    MonthlyReportStatus @default(draft)
  progressSummary           String              @map("progress_summary")
  projectTypeId             String?             @map("project_type_id") @db.Uuid
  projectType               ReportProjectType?  @relation(fields: [projectTypeId], references: [id])
  constructionLocation      String?             @map("construction_location") @db.VarChar(300)
  contractAmount            Decimal             @default(0) @map("contract_amount") @db.Decimal(14, 2)
  durationMonths            Int?                @map("duration_months")
  departmentEntity          String?             @map("department_entity") @db.VarChar(160)
  projectManager            String?             @map("project_manager") @db.VarChar(80)
  contactInfo               String?             @map("contact_info") @db.VarChar(120)
  overallProgress           String?             @map("overall_progress")
  monthlyConstructionStatus String?             @map("monthly_construction_status")
  equipmentModels           String?             @map("equipment_models")
  onsiteCount               Int                 @default(0) @map("onsite_count")
  onsiteVehicles            Int                 @default(0) @map("onsite_vehicles")
  safetyInspection          Boolean             @default(false) @map("safety_inspection")
  safetyHazards             Boolean             @default(false) @map("safety_hazards")
  safetyHazardDetail        String?             @map("safety_hazard_detail")
  safetyHazardCount         Int                 @default(0) @map("safety_hazard_count")
  rectifiedHazardCount      Int                 @default(0) @map("rectified_hazard_count")
  safetyInvestment          Decimal             @default(0) @map("safety_investment") @db.Decimal(14, 2)
  incidentCount             Int                 @default(0) @map("incident_count")
  notes                     String?
  projectStatus             ReportProjectStatus @default(active) @map("project_status")
  customData                Json                @default("{}") @map("custom_data")
  submittedBy               String?             @map("submitted_by") @db.Uuid
  submittedAt               DateTime?           @map("submitted_at")
  updatedBy                 String              @map("updated_by") @db.Uuid
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  @@unique([projectId, reportMonth])
  @@index([reportingOrganizationId, reportMonth])
  @@map("project_monthly_reports")
}

model ReportProjectType {
  id        String                 @id @default(uuid()) @db.Uuid
  name      String                 @unique @db.VarChar(160)
  sortOrder Int                    @default(0) @map("sort_order")
  active    Boolean                @default(true)
  reports   ProjectMonthlyReport[]
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("report_project_types")
}

model ReportField {
  id        String          @id @default(uuid()) @db.Uuid
  fieldKey  String          @unique @map("field_key") @db.VarChar(80)
  label     String          @db.VarChar(120)
  fieldType ReportFieldType @map("field_type")
  options   Json            @default("[]")
  required  Boolean         @default(false) @map("is_required")
  sortOrder Int             @default(0) @map("sort_order")
  active    Boolean         @default(true) @map("is_active")
  builtin   Boolean         @default(false) @map("is_builtin")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("report_fields")
}

model DepartmentMonthStatus {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id])
  reportingYear   Int          @map("reporting_year")
  reportingMonth  Int          @map("reporting_month")
  noFieldProjects Boolean      @default(true) @map("no_field_projects")
  confirmedAt     DateTime     @default(now()) @map("confirmed_at")
  confirmedBy     String       @map("confirmed_by") @db.Uuid
  note            String?      @db.VarChar(1000)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, reportingYear, reportingMonth])
  @@index([reportingYear, reportingMonth])
  @@map("department_month_statuses")
}

model PhoneVerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  phoneHash  String    @map("phone_hash") @db.VarChar(64)
  codeHash   String    @map("code_hash") @db.VarChar(64)
  purpose    String    @db.VarChar(40)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([phoneHash, purpose, createdAt])
  @@map("phone_verification_codes")
}

model Courseware {
  id        String              @id @default(uuid()) @db.Uuid
  title     String              @db.VarChar(180)
  type      CoursewareType
  scopeType ScopeType           @map("scope_type")
  scopeId   String?             @map("scope_id") @db.Uuid
  versions  CoursewareVersion[]
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@map("coursewares")
}

model CoursewareVersion {
  id            String                 @id @default(uuid()) @db.Uuid
  coursewareId  String                 @map("courseware_id") @db.Uuid
  courseware    Courseware             @relation(fields: [coursewareId], references: [id])
  version       Int
  status        PublishStatus          @default(draft)
  richText      String?                @map("rich_text")
  fileId        String?                @map("file_id") @db.Uuid
  file          PrivateFile?           @relation(fields: [fileId], references: [id])
  contentHash   String                 @map("content_hash") @db.VarChar(64)
  publishedAt   DateTime?              @map("published_at")
  templateItems TrainingTemplateItem[]
  progress      LearningProgress[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@unique([coursewareId, version])
  @@map("courseware_versions")
}

model TrainingTemplate {
  id        String                 @id @default(uuid()) @db.Uuid
  name      String                 @db.VarChar(180)
  type      TrainingType
  scopeType ScopeType              @map("scope_type")
  scopeId   String?                @map("scope_id") @db.Uuid
  active    Boolean                @default(true)
  items     TrainingTemplateItem[]
  batches   TrainingBatch[]
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@map("training_templates")
}

model TrainingTemplateItem {
  id                  String            @id @default(uuid()) @db.Uuid
  templateId          String            @map("template_id") @db.Uuid
  coursewareVersionId String            @map("courseware_version_id") @db.Uuid
  sortOrder           Int               @map("sort_order")
  template            TrainingTemplate  @relation(fields: [templateId], references: [id])
  coursewareVersion   CoursewareVersion @relation(fields: [coursewareVersionId], references: [id])
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([templateId, coursewareVersionId])
  @@map("training_template_items")
}

model QuestionBank {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @db.VarChar(160)
  scopeType ScopeType   @map("scope_type")
  scopeId   String?     @map("scope_id") @db.Uuid
  questions Question[]
  papers    ExamPaper[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("question_banks")
}

model Question {
  id          String          @id @default(uuid()) @db.Uuid
  bankId      String          @map("bank_id") @db.Uuid
  bank        QuestionBank    @relation(fields: [bankId], references: [id])
  type        QuestionType
  prompt      String
  options     Json
  correct     Json
  explanation String?
  active      Boolean         @default(true)
  paperItems  ExamPaperItem[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("questions")
}

model ExamPaper {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(160)
  mode        PaperMode
  bankId      String?         @map("bank_id") @db.Uuid
  bank        QuestionBank?   @relation(fields: [bankId], references: [id])
  randomCount Int?            @map("random_count")
  items       ExamPaperItem[]
  batches     TrainingBatch[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("exam_papers")
}

model ExamPaperItem {
  id         String    @id @default(uuid()) @db.Uuid
  paperId    String    @map("paper_id") @db.Uuid
  questionId String    @map("question_id") @db.Uuid
  sortOrder  Int       @map("sort_order")
  score      Decimal   @db.Decimal(6, 2)
  paper      ExamPaper @relation(fields: [paperId], references: [id])
  question   Question  @relation(fields: [questionId], references: [id])
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([paperId, questionId])
  @@map("exam_paper_items")
}

model TrainingBatch {
  id            String               @id @default(uuid()) @db.Uuid
  businessKey   String               @unique @map("business_key") @db.VarChar(180)
  name          String               @db.VarChar(180)
  type          TrainingType
  source        BatchSource          @default(online)
  templateId    String?              @map("template_id") @db.Uuid
  template      TrainingTemplate?    @relation(fields: [templateId], references: [id])
  projectId     String?              @map("project_id") @db.Uuid
  project       Project?             @relation(fields: [projectId], references: [id])
  paperId       String?              @map("paper_id") @db.Uuid
  paper         ExamPaper?           @relation(fields: [paperId], references: [id])
  dueAt         DateTime?            @map("due_at")
  durationMin   Int                  @default(30) @map("duration_min")
  passScore     Decimal              @default(80) @map("pass_score") @db.Decimal(6, 2)
  maxAttempts   Int                  @default(3) @map("max_attempts")
  offlineDetail Json?                @map("offline_detail")
  assignments   TrainingAssignment[]
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@map("training_batches")
}

model TrainingAssignment {
  id            String                @id @default(uuid()) @db.Uuid
  batchId       String                @map("batch_id") @db.Uuid
  personId      String                @map("person_id") @db.Uuid
  batch         TrainingBatch         @relation(fields: [batchId], references: [id])
  person        Person                @relation(fields: [personId], references: [id])
  status        AssignmentStatus      @default(pending_learning)
  completedAt   DateTime?             @map("completed_at")
  cancelledAt   DateTime?             @map("cancelled_at")
  progress      LearningProgress[]
  attempts      ExamAttempt[]
  signatures    Signature[]
  confirmations ProjectConfirmation[]
  notifications Notification[]
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@unique([batchId, personId])
  @@map("training_assignments")
}

model LearningProgress {
  id                  String             @id @default(uuid()) @db.Uuid
  assignmentId        String             @map("assignment_id") @db.Uuid
  coursewareVersionId String             @map("courseware_version_id") @db.Uuid
  assignment          TrainingAssignment @relation(fields: [assignmentId], references: [id])
  coursewareVersion   CoursewareVersion  @relation(fields: [coursewareVersionId], references: [id])
  openedAt            DateTime?          @map("opened_at")
  reachedEndAt        DateTime?          @map("reached_end_at")
  completedAt         DateTime?          @map("completed_at")
  remediationRound    Int                @default(0) @map("remediation_round")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([assignmentId, coursewareVersionId, remediationRound])
  @@map("learning_progress")
}

model ExamAttempt {
  id            String             @id @default(uuid()) @db.Uuid
  assignmentId  String             @map("assignment_id") @db.Uuid
  assignment    TrainingAssignment @relation(fields: [assignmentId], references: [id])
  attemptNumber Int                @map("attempt_number")
  status        AttemptStatus      @default(in_progress)
  snapshot      Json
  startedAt     DateTime           @default(now()) @map("started_at")
  expiresAt     DateTime           @map("expires_at")
  submittedAt   DateTime?          @map("submitted_at")
  score         Decimal?           @db.Decimal(6, 2)
  passed        Boolean?
  answers       ExamAnswer[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@unique([assignmentId, attemptNumber])
  @@map("exam_attempts")
}

model ExamAnswer {
  id         String      @id @default(uuid()) @db.Uuid
  attemptId  String      @map("attempt_id") @db.Uuid
  questionId String      @map("question_id") @db.Uuid
  answer     Json
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id])
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@unique([attemptId, questionId])
  @@map("exam_answers")
}

model Signature {
  id             String             @id @default(uuid()) @db.Uuid
  assignmentId   String             @map("assignment_id") @db.Uuid
  personId       String             @map("person_id") @db.Uuid
  fileId         String             @map("file_id") @db.Uuid
  assignment     TrainingAssignment @relation(fields: [assignmentId], references: [id])
  person         Person             @relation(fields: [personId], references: [id])
  file           PrivateFile        @relation(fields: [fileId], references: [id])
  recordHash     String             @map("record_hash") @db.VarChar(64)
  deviceInfo     Json?              @map("device_info")
  correctionOfId String?            @map("correction_of_id") @db.Uuid
  correctionOf   Signature?         @relation("SignatureCorrection", fields: [correctionOfId], references: [id])
  corrections    Signature[]        @relation("SignatureCorrection")
  signedAt       DateTime           @default(now()) @map("signed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([assignmentId, correctionOfId])
  @@map("signatures")
}

model ProjectConfirmation {
  id           String             @id @default(uuid()) @db.Uuid
  assignmentId String             @map("assignment_id") @db.Uuid
  assignment   TrainingAssignment @relation(fields: [assignmentId], references: [id])
  confirmedBy  String             @map("confirmed_by") @db.Uuid
  note         String?
  round        Int                @default(0)
  confirmedAt  DateTime           @default(now()) @map("confirmed_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([assignmentId, round])
  @@map("project_confirmations")
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  personId     String              @map("person_id") @db.Uuid
  assignmentId String?             @map("assignment_id") @db.Uuid
  person       Person              @relation(fields: [personId], references: [id])
  assignment   TrainingAssignment? @relation(fields: [assignmentId], references: [id])
  title        String              @db.VarChar(160)
  body         String
  dedupeKey    String?             @unique @map("dedupe_key") @db.VarChar(180)
  status       NotificationStatus  @default(unread)
  sentAt       DateTime?           @map("sent_at")
  outbox       NotificationOutbox?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("notifications")
}

model NotificationOutbox {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @unique @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         OutboxStatus @default(pending)
  attemptCount   Int          @default(0) @map("attempt_count")
  nextAttemptAt  DateTime?    @map("next_attempt_at")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("notification_outbox")
}

model ChangeRequest {
  id         String              @id @default(uuid()) @db.Uuid
  personId   String?             @map("person_id") @db.Uuid
  person     Person?             @relation(fields: [personId], references: [id])
  accountId  String?             @map("account_id") @db.Uuid
  projectId  String?             @map("project_id") @db.Uuid
  type       ChangeRequestType
  status     ChangeRequestStatus @default(pending)
  payload    Json
  reviewedBy String?             @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?           @map("reviewed_at")
  reviewNote String?             @map("review_note") @db.VarChar(500)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@map("change_requests")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  objectType String   @map("object_type") @db.VarChar(80)
  objectId   String?  @map("object_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([objectType, objectId])
  @@map("audit_logs")
}

model UserPreference {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  key       String   @db.VarChar(80)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountId, key])
  @@map("user_preferences")
}
