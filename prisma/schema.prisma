generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  pending
  active
  disabled
}

enum PersonType {
  employee
  contractor
  temporary_individual
}

enum PersonStatus {
  pending
  active
  disabled
}

enum OrganizationType {
  company
  business_entity
  department
  contractor
}

enum RoleName {
  company_admin
  org_leader
  org_admin
  field_reporter
  project_admin
  learner
}

enum ScopeType {
  company
  organization
  project
  person
}

enum ProjectStatus {
  active
  paused
  ended
}

enum MembershipStatus {
  pending
  active
  rejected
  removed
}

enum FileKind {
  photo
  signature
  courseware
  attachment
}

enum CoursewareType {
  rich_text
  single_html
}

enum PublishStatus {
  draft
  published
  retired
}

enum TrainingType {
  three_level
  project_induction
  routine
  change_update
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
}

enum PaperMode {
  fixed
  random
}

enum BatchSource {
  online
  offline
  reconfirmation
}

enum AssignmentStatus {
  pending_learning
  learning
  pending_exam
  remediation_required
  locked
  pending_signature
  confirmation_pending
  completed
  cancelled
}

enum AttemptStatus {
  in_progress
  submitted
  expired
}

enum NotificationStatus {
  unread
  read
}

enum ChangeRequestType {
  binding
  profile_change
  registration
  binding_change
  department_transfer
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
  duplicate
  cancelled
}

enum OutboxStatus {
  pending
  sent
  skipped
  failed
}

model Account {
  id              String           @id @default(uuid()) @db.Uuid
  username        String?          @unique @db.VarChar(80)
  passwordHash    String?          @map("password_hash")
  status          AccountStatus    @default(active)
  sessionVersion  Int              @default(0) @map("session_version")
  personId        String?          @unique @map("person_id") @db.Uuid
  person          Person?          @relation(fields: [personId], references: [id])
  roles           RoleAssignment[]
  wechatBindings  WechatBinding[]
  refreshSessions RefreshSession[]
  preferences     UserPreference[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("accounts")
}

model Person {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(80)
  phone              String                   @db.VarChar(20)
  type               PersonType
  status             PersonStatus             @default(pending)
  nationalIdCipher   String?                  @map("national_id_cipher")
  nationalIdIv       String?                  @map("national_id_iv")
  nationalIdTag      String?                  @map("national_id_tag")
  nationalIdHash     String?                  @map("national_id_hash") @db.VarChar(64)
  nationalIdLast4    String?                  @map("national_id_last4") @db.Char(4)
  photoFileId        String?                  @map("photo_file_id") @db.Uuid
  photoFile          PrivateFile?             @relation("PersonPhoto", fields: [photoFileId], references: [id])
  account            Account?
  organizations      OrganizationMembership[]
  projectMemberships ProjectMember[]
  assignments        TrainingAssignment[]
  signatures         Signature[]
  changeRequests     ChangeRequest[]
  notifications      Notification[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@unique([nationalIdHash])
  @@index([phone, status])
  @@map("persons")
}

model WechatBinding {
  id        String    @id @default(uuid()) @db.Uuid
  appId     String    @map("app_id") @db.VarChar(64)
  openid    String    @db.VarChar(128)
  unionid   String?   @db.VarChar(128)
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id])
  active    Boolean   @default(true)
  boundAt   DateTime? @map("bound_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([appId, openid])
  @@map("wechat_bindings")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("refresh_sessions")
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(120)
  type        OrganizationType
  parentId    String?                  @map("parent_id") @db.Uuid
  parent      Organization?            @relation("OrganizationTree", fields: [parentId], references: [id])
  children    Organization[]           @relation("OrganizationTree")
  memberships OrganizationMembership[]
  projects    Project[]
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@unique([parentId, name])
  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  personId       String       @map("person_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  person         Person       @relation(fields: [personId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  primary        Boolean      @default(false)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([personId, organizationId])
  @@map("organization_memberships")
}

model RoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      RoleName
  scopeType ScopeType @map("scope_type")
  scopeId   String?   @map("scope_id") @db.Uuid
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([accountId, role, scopeType, scopeId])
  @@index([role, scopeType, scopeId, active])
  @@map("role_assignments")
}

model Project {
  id                        String          @id @default(uuid()) @db.Uuid
  name                      String          @db.VarChar(160)
  code                      String          @unique @db.VarChar(50)
  responsibleOrganizationId String          @map("responsible_organization_id") @db.Uuid
  responsibleOrganization   Organization    @relation(fields: [responsibleOrganizationId], references: [id])
  status                    ProjectStatus   @default(active)
  members                   ProjectMember[]
  batches                   TrainingBatch[]
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMember {
  id         String           @id @default(uuid()) @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  personId   String           @map("person_id") @db.Uuid
  project    Project          @relation(fields: [projectId], references: [id])
  person     Person           @relation(fields: [personId], references: [id])
  status     MembershipStatus @default(pending)
  reviewedBy String?          @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?        @map("reviewed_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([projectId, personId])
  @@map("project_members")
}

model PrivateFile {
  id           String              @id @default(uuid()) @db.Uuid
  kind         FileKind
  storageKey   String              @unique @map("storage_key")
  originalName String              @map("original_name")
  mimeType     String              @map("mime_type")
  size         Int
  sha256       String              @db.VarChar(64)
  uploadedBy   String              @map("uploaded_by") @db.Uuid
  personPhotos Person[]            @relation("PersonPhoto")
  versions     CoursewareVersion[]
  signatures   Signature[]
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("files")
}

model Courseware {
  id        String              @id @default(uuid()) @db.Uuid
  title     String              @db.VarChar(180)
  type      CoursewareType
  scopeType ScopeType           @map("scope_type")
  scopeId   String?             @map("scope_id") @db.Uuid
  versions  CoursewareVersion[]
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@map("coursewares")
}

model CoursewareVersion {
  id            String                 @id @default(uuid()) @db.Uuid
  coursewareId  String                 @map("courseware_id") @db.Uuid
  courseware    Courseware             @relation(fields: [coursewareId], references: [id])
  version       Int
  status        PublishStatus          @default(draft)
  richText      String?                @map("rich_text")
  fileId        String?                @map("file_id") @db.Uuid
  file          PrivateFile?           @relation(fields: [fileId], references: [id])
  contentHash   String                 @map("content_hash") @db.VarChar(64)
  publishedAt   DateTime?              @map("published_at")
  templateItems TrainingTemplateItem[]
  progress      LearningProgress[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@unique([coursewareId, version])
  @@map("courseware_versions")
}

model TrainingTemplate {
  id        String                 @id @default(uuid()) @db.Uuid
  name      String                 @db.VarChar(180)
  type      TrainingType
  scopeType ScopeType              @map("scope_type")
  scopeId   String?                @map("scope_id") @db.Uuid
  active    Boolean                @default(true)
  items     TrainingTemplateItem[]
  batches   TrainingBatch[]
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  @@map("training_templates")
}

model TrainingTemplateItem {
  id                  String            @id @default(uuid()) @db.Uuid
  templateId          String            @map("template_id") @db.Uuid
  coursewareVersionId String            @map("courseware_version_id") @db.Uuid
  sortOrder           Int               @map("sort_order")
  template            TrainingTemplate  @relation(fields: [templateId], references: [id])
  coursewareVersion   CoursewareVersion @relation(fields: [coursewareVersionId], references: [id])
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([templateId, coursewareVersionId])
  @@map("training_template_items")
}

model QuestionBank {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @db.VarChar(160)
  scopeType ScopeType   @map("scope_type")
  scopeId   String?     @map("scope_id") @db.Uuid
  questions Question[]
  papers    ExamPaper[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("question_banks")
}

model Question {
  id          String          @id @default(uuid()) @db.Uuid
  bankId      String          @map("bank_id") @db.Uuid
  bank        QuestionBank    @relation(fields: [bankId], references: [id])
  type        QuestionType
  prompt      String
  options     Json
  correct     Json
  explanation String?
  active      Boolean         @default(true)
  paperItems  ExamPaperItem[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("questions")
}

model ExamPaper {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(160)
  mode        PaperMode
  bankId      String?         @map("bank_id") @db.Uuid
  bank        QuestionBank?   @relation(fields: [bankId], references: [id])
  randomCount Int?            @map("random_count")
  items       ExamPaperItem[]
  batches     TrainingBatch[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("exam_papers")
}

model ExamPaperItem {
  id         String    @id @default(uuid()) @db.Uuid
  paperId    String    @map("paper_id") @db.Uuid
  questionId String    @map("question_id") @db.Uuid
  sortOrder  Int       @map("sort_order")
  score      Decimal   @db.Decimal(6, 2)
  paper      ExamPaper @relation(fields: [paperId], references: [id])
  question   Question  @relation(fields: [questionId], references: [id])
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([paperId, questionId])
  @@map("exam_paper_items")
}

model TrainingBatch {
  id            String               @id @default(uuid()) @db.Uuid
  businessKey   String               @unique @map("business_key") @db.VarChar(180)
  name          String               @db.VarChar(180)
  type          TrainingType
  source        BatchSource          @default(online)
  templateId    String?              @map("template_id") @db.Uuid
  template      TrainingTemplate?    @relation(fields: [templateId], references: [id])
  projectId     String?              @map("project_id") @db.Uuid
  project       Project?             @relation(fields: [projectId], references: [id])
  paperId       String?              @map("paper_id") @db.Uuid
  paper         ExamPaper?           @relation(fields: [paperId], references: [id])
  dueAt         DateTime?            @map("due_at")
  durationMin   Int                  @default(30) @map("duration_min")
  passScore     Decimal              @default(80) @map("pass_score") @db.Decimal(6, 2)
  maxAttempts   Int                  @default(3) @map("max_attempts")
  offlineDetail Json?                @map("offline_detail")
  assignments   TrainingAssignment[]
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@map("training_batches")
}

model TrainingAssignment {
  id            String                @id @default(uuid()) @db.Uuid
  batchId       String                @map("batch_id") @db.Uuid
  personId      String                @map("person_id") @db.Uuid
  batch         TrainingBatch         @relation(fields: [batchId], references: [id])
  person        Person                @relation(fields: [personId], references: [id])
  status        AssignmentStatus      @default(pending_learning)
  completedAt   DateTime?             @map("completed_at")
  cancelledAt   DateTime?             @map("cancelled_at")
  progress      LearningProgress[]
  attempts      ExamAttempt[]
  signatures    Signature[]
  confirmations ProjectConfirmation[]
  notifications Notification[]
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@unique([batchId, personId])
  @@map("training_assignments")
}

model LearningProgress {
  id                  String             @id @default(uuid()) @db.Uuid
  assignmentId        String             @map("assignment_id") @db.Uuid
  coursewareVersionId String             @map("courseware_version_id") @db.Uuid
  assignment          TrainingAssignment @relation(fields: [assignmentId], references: [id])
  coursewareVersion   CoursewareVersion  @relation(fields: [coursewareVersionId], references: [id])
  openedAt            DateTime?          @map("opened_at")
  reachedEndAt        DateTime?          @map("reached_end_at")
  completedAt         DateTime?          @map("completed_at")
  remediationRound    Int                @default(0) @map("remediation_round")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@unique([assignmentId, coursewareVersionId, remediationRound])
  @@map("learning_progress")
}

model ExamAttempt {
  id            String             @id @default(uuid()) @db.Uuid
  assignmentId  String             @map("assignment_id") @db.Uuid
  assignment    TrainingAssignment @relation(fields: [assignmentId], references: [id])
  attemptNumber Int                @map("attempt_number")
  status        AttemptStatus      @default(in_progress)
  snapshot      Json
  startedAt     DateTime           @default(now()) @map("started_at")
  expiresAt     DateTime           @map("expires_at")
  submittedAt   DateTime?          @map("submitted_at")
  score         Decimal?           @db.Decimal(6, 2)
  passed        Boolean?
  answers       ExamAnswer[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@unique([assignmentId, attemptNumber])
  @@map("exam_attempts")
}

model ExamAnswer {
  id         String      @id @default(uuid()) @db.Uuid
  attemptId  String      @map("attempt_id") @db.Uuid
  questionId String      @map("question_id") @db.Uuid
  answer     Json
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id])
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@unique([attemptId, questionId])
  @@map("exam_answers")
}

model Signature {
  id             String             @id @default(uuid()) @db.Uuid
  assignmentId   String             @map("assignment_id") @db.Uuid
  personId       String             @map("person_id") @db.Uuid
  fileId         String             @map("file_id") @db.Uuid
  assignment     TrainingAssignment @relation(fields: [assignmentId], references: [id])
  person         Person             @relation(fields: [personId], references: [id])
  file           PrivateFile        @relation(fields: [fileId], references: [id])
  recordHash     String             @map("record_hash") @db.VarChar(64)
  deviceInfo     Json?              @map("device_info")
  correctionOfId String?            @map("correction_of_id") @db.Uuid
  correctionOf   Signature?         @relation("SignatureCorrection", fields: [correctionOfId], references: [id])
  corrections    Signature[]        @relation("SignatureCorrection")
  signedAt       DateTime           @default(now()) @map("signed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([assignmentId, correctionOfId])
  @@map("signatures")
}

model ProjectConfirmation {
  id           String             @id @default(uuid()) @db.Uuid
  assignmentId String             @map("assignment_id") @db.Uuid
  assignment   TrainingAssignment @relation(fields: [assignmentId], references: [id])
  confirmedBy  String             @map("confirmed_by") @db.Uuid
  note         String?
  round        Int                @default(0)
  confirmedAt  DateTime           @default(now()) @map("confirmed_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([assignmentId, round])
  @@map("project_confirmations")
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  personId     String              @map("person_id") @db.Uuid
  assignmentId String?             @map("assignment_id") @db.Uuid
  person       Person              @relation(fields: [personId], references: [id])
  assignment   TrainingAssignment? @relation(fields: [assignmentId], references: [id])
  title        String              @db.VarChar(160)
  body         String
  dedupeKey    String?             @unique @map("dedupe_key") @db.VarChar(180)
  status       NotificationStatus  @default(unread)
  sentAt       DateTime?           @map("sent_at")
  outbox       NotificationOutbox?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@map("notifications")
}

model NotificationOutbox {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @unique @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         OutboxStatus @default(pending)
  attemptCount   Int          @default(0) @map("attempt_count")
  nextAttemptAt  DateTime?    @map("next_attempt_at")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("notification_outbox")
}

model ChangeRequest {
  id         String              @id @default(uuid()) @db.Uuid
  personId   String?             @map("person_id") @db.Uuid
  person     Person?             @relation(fields: [personId], references: [id])
  accountId  String?             @map("account_id") @db.Uuid
  projectId  String?             @map("project_id") @db.Uuid
  type       ChangeRequestType
  status     ChangeRequestStatus @default(pending)
  payload    Json
  reviewedBy String?             @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?           @map("reviewed_at")
  reviewNote String?             @map("review_note") @db.VarChar(500)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@map("change_requests")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  objectType String   @map("object_type") @db.VarChar(80)
  objectId   String?  @map("object_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([objectType, objectId])
  @@map("audit_logs")
}

model UserPreference {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  key       String   @db.VarChar(80)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountId, key])
  @@map("user_preferences")
}
