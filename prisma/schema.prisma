generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  pending
  active
  disabled
  merged
}

enum PersonType {
  employee
  contractor
  temporary_individual
}

enum PersonStatus {
  pending
  active
  disabled
  merged
}

enum OrganizationType {
  company
  business_entity
  department
  contractor
}

enum RoleName {
  company_admin
  org_leader
  org_admin
  field_reporter
  project_admin
  learner
}

enum ScopeType {
  company
  organization
  project
  person
}

enum ProjectStatus {
  active
  paused
  ended
}

enum MembershipStatus {
  pending
  active
  approved
  rejected
  withdrawn
  removed
  ended
  cancelled
}

enum FileKind {
  photo
  signature
  courseware
  attachment
}

enum CoursewareType {
  rich_text
  single_html
  structured
}

enum PublishStatus {
  draft
  published
  retired
}

enum CoursewareImportStatus {
  previewed
  confirming
  confirmed
  failed
  expired
}

enum TrainingType {
  three_level
  project_induction
  routine
  change_update
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
}

enum PaperMode {
  fixed
  random
}

enum BatchSource {
  online
  offline
  reconfirmation
}

enum AssignmentStatus {
  pending_learning
  learning
  pending_exam
  remediation_required
  locked
  pending_signature
  confirmation_pending
  completed
  cancelled
}

enum AttemptStatus {
  in_progress
  submitted
  expired
}

enum NotificationStatus {
  unread
  read
}

enum ChangeRequestType {
  binding
  profile_change
  registration
  binding_change
  department_transfer
  account_merge
  person_merge
  account_opening
  account_recovery
  identity_correction
  person_reactivation
  contractor_unit_change
  responsible_entity_change
  project_exit
  cross_entity_project_admin
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
  withdrawn
  duplicate
  cancelled
  failed
}

enum OutboxStatus {
  pending
  sent
  skipped
  failed
}

enum MonthlyReportStatus {
  draft
  submitted
  withdrawn
  voided
}

enum ReportProjectStatus {
  active
  completed
}

enum ReportFieldType {
  text
  number
  textarea
  select
  date
}

enum CertificateCategory {
  company
  personal
}

enum CertificateLifecycleStatus {
  active
  replaced
  revoked
  voided
}

enum HistoricalRecordStatus {
  active
  voided
}

enum CertificateTrainingStatus {
  trained
  not_required
  pending
}

enum SensitiveExportStatus {
  pending
  processing
  ready
  failed
  downloaded
  expired
}

enum SensitiveExportScopeType {
  company
  organization
  project
  self
}

enum ReceivableGrantRole {
  admin
  reporter
  readonly
}

enum ReceivableRecordStatus {
  active
  voided
}

enum ReceivableDetailSource {
  manual
  opening_import
}

enum ReceivableImportStatus {
  previewed
  applied
  failed
  rolled_back
}

enum ReceivableExportStatus {
  pending
  processing
  completed
  failed
  expired
}

model Account {
  id                                     String                       @id @default(uuid()) @db.Uuid
  username                               String?                      @unique @db.VarChar(80)
  usernameNormalized                     String?                      @unique @map("username_normalized") @db.VarChar(80)
  passwordHash                           String?                      @map("password_hash")
  mustChangePassword                     Boolean                      @default(false) @map("must_change_password")
  passwordLoginEnabled                   Boolean                      @default(false) @map("password_login_enabled")
  status                                 AccountStatus                @default(active)
  sessionVersion                         Int                          @default(0) @map("session_version")
  lastLoginAt                            DateTime?                    @map("last_login_at")
  failedLoginCount                       Int                          @default(0) @map("failed_login_count")
  loginLockedUntil                       DateTime?                    @map("login_locked_until")
  personId                               String?                      @unique @map("person_id") @db.Uuid
  verifiedPhone                          String?                      @unique @map("verified_phone") @db.VarChar(20)
  mergedIntoAccountId                    String?                      @map("merged_into_account_id") @db.Uuid
  mergedAt                               DateTime?                    @map("merged_at")
  person                                 Person?                      @relation(fields: [personId], references: [id])
  mergedInto                             Account?                     @relation("AccountMerge", fields: [mergedIntoAccountId], references: [id])
  mergedAccounts                         Account[]                    @relation("AccountMerge")
  roles                                  RoleAssignment[]
  wechatBindings                         WechatBinding[]
  refreshSessions                        RefreshSession[]
  usernameHistory                        UsernameHistory[]
  preferences                            UserPreference[]
  sensitiveExportJobs                    SensitiveExportJob[]
  securityEvents                         AuthSecurityEvent[]
  receivableGrants                       ReceivableAccessGrant[]      @relation("ReceivableGrantAccount")
  receivableGrantsGiven                  ReceivableAccessGrant[]      @relation("ReceivableGrantGrantedBy")
  receivableGrantsRevoked                ReceivableAccessGrant[]      @relation("ReceivableGrantRevokedBy")
  receivableConfigurationsConfirmed      ReceivableSetting[]          @relation("ReceivableConfigurationConfirmer")
  receivableDepartmentsDeactivated       ReceivableDepartment[]       @relation("ReceivableDepartmentDeactivatedBy")
  receivableDictionaryOptionsDeactivated ReceivableDictionaryOption[] @relation("ReceivableDictionaryDeactivatedBy")
  receivableLedgersCreated               ReceivableLedger[]           @relation("ReceivableLedgerCreatedBy")
  receivableLedgersUpdated               ReceivableLedger[]           @relation("ReceivableLedgerUpdatedBy")
  receivableLedgersVoided                ReceivableLedger[]           @relation("ReceivableLedgerVoidedBy")
  receivableLedgerRevisions              ReceivableLedgerRevision[]   @relation("ReceivableLedgerRevisionChangedBy")
  receivableInvoicesCreated              ReceivableInvoice[]          @relation("ReceivableInvoiceCreatedBy")
  receivableInvoicesVoided               ReceivableInvoice[]          @relation("ReceivableInvoiceVoidedBy")
  receivableReceiptsCreated              ReceivableReceipt[]          @relation("ReceivableReceiptCreatedBy")
  receivableReceiptsVoided               ReceivableReceipt[]          @relation("ReceivableReceiptVoidedBy")
  receivableAttachmentsUploaded          ReceivableAttachment[]       @relation("ReceivableAttachmentUploadedBy")
  receivableAttachmentsVoided            ReceivableAttachment[]       @relation("ReceivableAttachmentVoidedBy")
  receivableImportBatchesRequested       ReceivableImportBatch[]      @relation("ReceivableImportRequestedBy")
  receivableImportBatchesApplied         ReceivableImportBatch[]      @relation("ReceivableImportAppliedBy")
  receivableImportBatchesRolledBack      ReceivableImportBatch[]      @relation("ReceivableImportRolledBackBy")
  receivableExportJobs                   ReceivableExportJob[]
  coursewareImportSessions               CoursewareImportSession[]
  createdAt                              DateTime                     @default(now()) @map("created_at")
  updatedAt                              DateTime                     @updatedAt @map("updated_at")

  @@index([mergedIntoAccountId])
  @@map("accounts")
}

model UsernameHistory {
  id                 String   @id @default(uuid()) @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  username           String   @db.VarChar(80)
  usernameNormalized String   @map("username_normalized") @db.VarChar(80)
  endedAt            DateTime @default(now()) @map("ended_at")
  changedBy          String?  @map("changed_by") @db.Uuid
  reason             String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([usernameNormalized])
  @@index([accountId, endedAt])
  @@map("username_history")
}

model Person {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String                   @db.VarChar(80)
  phone                   String                   @db.VarChar(20)
  type                    PersonType
  status                  PersonStatus             @default(pending)
  nationalIdCipher        String?                  @map("national_id_cipher")
  nationalIdIv            String?                  @map("national_id_iv")
  nationalIdTag           String?                  @map("national_id_tag")
  nationalIdHash          String?                  @map("national_id_hash") @db.VarChar(64)
  nationalIdLast4         String?                  @map("national_id_last4") @db.Char(4)
  photoFileId             String?                  @map("photo_file_id") @db.Uuid
  mergedIntoPersonId      String?                  @map("merged_into_person_id") @db.Uuid
  mergedAt                DateTime?                @map("merged_at")
  mergedBy                String?                  @map("merged_by") @db.Uuid
  mergeReason             String?                  @map("merge_reason") @db.VarChar(500)
  photoFile               PrivateFile?             @relation("PersonPhoto", fields: [photoFileId], references: [id], onDelete: Restrict)
  mergedInto              Person?                  @relation("PersonMerge", fields: [mergedIntoPersonId], references: [id], onDelete: Restrict)
  mergedPersons           Person[]                 @relation("PersonMerge")
  account                 Account?
  organizations           OrganizationMembership[]
  projectMemberships      ProjectMember[]
  assignments             TrainingAssignment[]
  signatures              Signature[]
  changeRequests          ChangeRequest[]
  notifications           Notification[]
  certificates            PersonCertificate[]
  roleAssignments         RoleAssignment[]
  coursewarePublishGrants CoursewarePublishGrant[]
  photoHistory            PersonPhotoHistory[]
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  @@unique([nationalIdHash])
  @@index([phone, status])
  @@index([mergedIntoPersonId])
  @@map("persons")
}

model WechatBinding {
  id        String    @id @default(uuid()) @db.Uuid
  appId     String    @map("app_id") @db.VarChar(64)
  openid    String    @db.VarChar(128)
  unionid   String?   @db.VarChar(128)
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id])
  active    Boolean   @default(true)
  boundAt   DateTime? @map("bound_at")
  endedAt   DateTime? @map("ended_at")
  endedBy   String?   @map("ended_by") @db.Uuid
  endReason String?   @map("end_reason") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([appId, openid, active])
  @@index([unionid, active])
  @@map("wechat_bindings")
}

model RefreshSession {
  id                String          @id @default(uuid()) @db.Uuid
  accountId         String          @map("account_id") @db.Uuid
  account           Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash         String          @unique @map("token_hash") @db.VarChar(64)
  clientKind        String?         @map("client_kind") @db.VarChar(20)
  loginMethod       String?         @map("login_method") @db.VarChar(20)
  familyId          String?         @map("family_id") @db.Uuid
  rotatedFromId     String?         @unique @map("rotated_from_id") @db.Uuid
  rotatedFrom       RefreshSession? @relation("RefreshRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo         RefreshSession? @relation("RefreshRotation")
  lastUsedAt        DateTime?       @map("last_used_at")
  userAgent         String?         @map("user_agent") @db.VarChar(500)
  expiresAt         DateTime        @map("expires_at")
  absoluteExpiresAt DateTime        @map("absolute_expires_at")
  revokedAt         DateTime?       @map("revoked_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@map("refresh_sessions")
}

model AuthSecurityEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  accountId             String?  @map("account_id") @db.Uuid
  account               Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountIdentifierHash String?  @map("account_identifier_hash") @db.VarChar(64)
  eventType             String   @map("event_type") @db.VarChar(80)
  loginMethod           String?  @map("login_method") @db.VarChar(20)
  clientKind            String?  @map("client_kind") @db.VarChar(20)
  sourceHash            String?  @map("source_hash") @db.VarChar(64)
  outcome               String   @db.VarChar(40)
  metadata              Json?
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@index([eventType, createdAt])
  @@map("auth_security_events")
}

model Organization {
  id                      String                      @id @default(uuid()) @db.Uuid
  name                    String                      @db.VarChar(120)
  type                    OrganizationType
  parentId                String?                     @map("parent_id") @db.Uuid
  reportingEnabled        Boolean                     @default(false) @map("reporting_enabled")
  parent                  Organization?               @relation("OrganizationTree", fields: [parentId], references: [id])
  children                Organization[]              @relation("OrganizationTree")
  memberships             OrganizationMembership[]
  projects                Project[]
  qualifications          OrganizationQualification[]
  monthlyReports          ProjectMonthlyReport[]
  departmentMonthStatuses DepartmentMonthStatus[]
  receivableSetting       ReceivableSetting?
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")

  @@unique([parentId, name])
  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  personId       String       @map("person_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  person         Person       @relation(fields: [personId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  primary        Boolean      @default(false)
  active         Boolean      @default(true)
  endedAt        DateTime?    @map("ended_at")
  endedBy        String?      @map("ended_by") @db.Uuid
  endReason      String?      @map("end_reason") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([personId, active, primary])
  @@index([organizationId, active])
  @@map("organization_memberships")
}

model RoleAssignment {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String?   @map("account_id") @db.Uuid
  account           Account?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  personId          String?   @map("person_id") @db.Uuid
  person            Person?   @relation(fields: [personId], references: [id], onDelete: Restrict)
  role              RoleName
  scopeType         ScopeType @map("scope_type")
  scopeId           String?   @map("scope_id") @db.Uuid
  active            Boolean   @default(true)
  activationPending Boolean   @default(false) @map("activation_pending")
  endedAt           DateTime? @map("ended_at")
  endedBy           String?   @map("ended_by") @db.Uuid
  endReason         String?   @map("end_reason") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([role, scopeType, scopeId, active])
  @@index([accountId, active])
  @@index([personId, active])
  @@map("role_assignments")
}

model Project {
  id                        String                 @id @default(uuid()) @db.Uuid
  name                      String                 @db.VarChar(160)
  code                      String                 @unique @db.VarChar(50)
  responsibleOrganizationId String                 @map("responsible_organization_id") @db.Uuid
  responsibleOrganization   Organization           @relation(fields: [responsibleOrganizationId], references: [id])
  status                    ProjectStatus          @default(active)
  projectType               String?                @map("project_type") @db.VarChar(120)
  location                  String?                @db.VarChar(300)
  contractAmount            Decimal?               @map("contract_amount") @db.Decimal(14, 2)
  plannedStartAt            DateTime?              @map("planned_start_at") @db.Date
  plannedEndAt              DateTime?              @map("planned_end_at") @db.Date
  managerName               String?                @map("manager_name") @db.VarChar(80)
  managerPhone              String?                @map("manager_phone") @db.VarChar(20)
  members                   ProjectMember[]
  batches                   TrainingBatch[]
  monthlyReports            ProjectMonthlyReport[]
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMember {
  id                   String           @id @default(uuid()) @db.Uuid
  projectId            String           @map("project_id") @db.Uuid
  personId             String           @map("person_id") @db.Uuid
  project              Project          @relation(fields: [projectId], references: [id])
  person               Person           @relation(fields: [personId], references: [id])
  status               MembershipStatus @default(pending)
  reviewedBy           String?          @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime?        @map("reviewed_at")
  previousMembershipId String?          @map("previous_membership_id") @db.Uuid
  previousMembership   ProjectMember?   @relation("ProjectMembershipHistory", fields: [previousMembershipId], references: [id], onDelete: Restrict)
  laterMemberships     ProjectMember[]  @relation("ProjectMembershipHistory")
  endedAt              DateTime?        @map("ended_at")
  endedBy              String?          @map("ended_by") @db.Uuid
  endReason            String?          @map("end_reason") @db.VarChar(500)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@index([projectId, personId, status])
  @@index([previousMembershipId])
  @@map("project_members")
}

model PrivateFile {
  id                         String                           @id @default(uuid()) @db.Uuid
  kind                       FileKind
  storageKey                 String                           @unique @map("storage_key")
  originalName               String                           @map("original_name")
  mimeType                   String                           @map("mime_type")
  size                       Int
  sha256                     String                           @db.VarChar(64)
  uploadedBy                 String                           @map("uploaded_by") @db.Uuid
  personPhotos               Person[]                         @relation("PersonPhoto")
  versions                   CoursewareVersion[]
  coursewareVersionAssets    CoursewareVersionAsset[]
  signatures                 Signature[]
  personCertificates         PersonCertificate[]
  organizationQualifications OrganizationQualification[]
  certificateAttachments     CertificateAttachment[]
  monthlyReportAttachments   ProjectMonthlyReportAttachment[]
  personPhotoHistory         PersonPhotoHistory[]
  requestAttachments         ChangeRequestAttachment[]
  receivableAttachments      ReceivableAttachment[]           @relation("ReceivableAttachmentFile")
  receivableImportBatches    ReceivableImportBatch[]          @relation("ReceivableImportOriginalFile")
  coursewareImportSources    CoursewareImportSession[]
  createdAt                  DateTime                         @default(now()) @map("created_at")
  updatedAt                  DateTime                         @updatedAt @map("updated_at")

  @@map("files")
}

model PersonPhotoHistory {
  id        String      @id @default(uuid()) @db.Uuid
  personId  String      @map("person_id") @db.Uuid
  person    Person      @relation(fields: [personId], references: [id], onDelete: Restrict)
  fileId    String      @map("file_id") @db.Uuid
  file      PrivateFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  active    Boolean     @default(true)
  changedBy String?     @map("changed_by") @db.Uuid
  endedAt   DateTime?   @map("ended_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([personId, active])
  @@index([fileId])
  @@map("person_photo_history")
}

model PersonCertificate {
  id                     String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId               String                            @map("person_id") @db.Uuid
  person                 Person                            @relation(fields: [personId], references: [id])
  name                   String                            @db.VarChar(160)
  category               String?                           @db.VarChar(80)
  typeId                 String?                           @map("type_id") @db.Uuid
  type                   CertificateType?                  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  subtype1Value          String?                           @map("subtype_1_value") @db.VarChar(120)
  subtype2Value          String?                           @map("subtype_2_value") @db.VarChar(120)
  certificateNoCipher    String?                           @map("certificate_no_cipher")
  certificateNoIv        String?                           @map("certificate_no_iv")
  certificateNoTag       String?                           @map("certificate_no_tag")
  certificateNoLast4     String?                           @map("certificate_no_last4") @db.VarChar(8)
  issuingAuthority       String?                           @map("issuing_authority") @db.VarChar(160)
  issuedAt               DateTime?                         @map("issued_at") @db.Date
  validFrom              DateTime?                         @map("valid_from") @db.Date
  expiresAt              DateTime?                         @map("expires_at") @db.Date
  isLongTerm             Boolean                           @default(false) @map("is_long_term")
  holderPosition         String?                           @map("holder_position") @db.VarChar(120)
  status                 CertificateLifecycleStatus        @default(active)
  trainingStatus         CertificateTrainingStatus?        @default(pending) @map("training_status")
  remark                 String?                           @db.VarChar(2000)
  renewedFromId          String?                           @map("renewed_from_id") @db.Uuid
  renewedFrom            PersonCertificate?                @relation("PersonCertificateRenewal", fields: [renewedFromId], references: [id], onDelete: Restrict)
  renewals               PersonCertificate[]               @relation("PersonCertificateRenewal")
  renewedAt              DateTime?                         @map("renewed_at")
  voidedAt               DateTime?                         @map("voided_at")
  voidedBy               String?                           @map("voided_by") @db.Uuid
  voidReason             String?                           @map("void_reason") @db.VarChar(500)
  createdBy              String?                           @map("created_by") @db.Uuid
  fileId                 String?                           @map("file_id") @db.Uuid
  file                   PrivateFile?                      @relation(fields: [fileId], references: [id])
  attachments            CertificateAttachment[]
  trainingRecords        CertificateTrainingRecord[]
  annualTrainingStatuses CertificateAnnualTrainingStatus[]
  active                 Boolean                           @default(true)
  createdAt              DateTime                          @default(now()) @map("created_at")
  updatedAt              DateTime                          @updatedAt @map("updated_at")

  @@index([personId, active, expiresAt])
  @@map("person_certificates")
}

model OrganizationQualification {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                      @map("organization_id") @db.Uuid
  organization        Organization                @relation(fields: [organizationId], references: [id])
  name                String                      @db.VarChar(160)
  category            String?                     @db.VarChar(80)
  typeId              String?                     @map("type_id") @db.Uuid
  type                CertificateType?            @relation(fields: [typeId], references: [id], onDelete: Restrict)
  subtype1Value       String?                     @map("subtype_1_value") @db.VarChar(120)
  subtype2Value       String?                     @map("subtype_2_value") @db.VarChar(120)
  certificateNoCipher String?                     @map("certificate_no_cipher")
  certificateNoIv     String?                     @map("certificate_no_iv")
  certificateNoTag    String?                     @map("certificate_no_tag")
  certificateNoLast4  String?                     @map("certificate_no_last4") @db.VarChar(8)
  issuingAuthority    String?                     @map("issuing_authority") @db.VarChar(160)
  issuedAt            DateTime?                   @map("issued_at") @db.Date
  validFrom           DateTime?                   @map("valid_from") @db.Date
  expiresAt           DateTime?                   @map("expires_at") @db.Date
  isLongTerm          Boolean                     @default(false) @map("is_long_term")
  status              CertificateLifecycleStatus  @default(active)
  remark              String?                     @db.VarChar(2000)
  renewedFromId       String?                     @map("renewed_from_id") @db.Uuid
  renewedFrom         OrganizationQualification?  @relation("OrganizationQualificationRenewal", fields: [renewedFromId], references: [id], onDelete: Restrict)
  renewals            OrganizationQualification[] @relation("OrganizationQualificationRenewal")
  renewedAt           DateTime?                   @map("renewed_at")
  createdBy           String?                     @map("created_by") @db.Uuid
  scope               String?
  voidedAt            DateTime?                   @map("voided_at")
  voidedBy            String?                     @map("voided_by") @db.Uuid
  voidReason          String?                     @map("void_reason") @db.VarChar(500)
  fileId              String?                     @map("file_id") @db.Uuid
  file                PrivateFile?                @relation(fields: [fileId], references: [id])
  attachments         CertificateAttachment[]
  active              Boolean                     @default(true)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@index([organizationId, active, expiresAt], map: "organization_qualifications_organization_id_active_expires_at_i")
  @@map("organization_qualifications")
}

model CertificateType {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @unique @db.VarChar(160)
  category                   CertificateCategory
  subtype1Label              String?                     @map("subtype_1_label") @db.VarChar(80)
  subtype1Options            Json                        @default("[]") @map("subtype_1_options")
  subtype2Label              String?                     @map("subtype_2_label") @db.VarChar(80)
  subtype2Options            Json                        @default("[]") @map("subtype_2_options")
  sortOrder                  Int                         @default(0) @map("sort_order")
  active                     Boolean                     @default(true)
  requiresAnnualTraining     Boolean                     @default(false) @map("requires_annual_training")
  personCertificates         PersonCertificate[]
  organizationQualifications OrganizationQualification[]
  createdAt                  DateTime                    @default(now()) @map("created_at")
