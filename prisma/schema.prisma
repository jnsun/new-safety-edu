generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  pending
  active
  disabled
  merged
}

enum PersonType {
  employee
  contractor
  temporary_individual
}

enum PersonStatus {
  pending
  active
  disabled
}

enum OrganizationType {
  company
  business_entity
  department
  contractor
}

enum RoleName {
  company_admin
  org_leader
  org_admin
  field_reporter
  project_admin
  learner
}

enum ScopeType {
  company
  organization
  project
  person
}

enum ProjectStatus {
  active
  paused
  ended
}

enum MembershipStatus {
  pending
  active
  rejected
  removed
}

enum FileKind {
  photo
  signature
  courseware
  attachment
}

enum CoursewareType {
  rich_text
  single_html
}

enum PublishStatus {
  draft
  published
  retired
}

enum TrainingType {
  three_level
  project_induction
  routine
  change_update
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
}

enum PaperMode {
  fixed
  random
}

enum BatchSource {
  online
  offline
  reconfirmation
}

enum AssignmentStatus {
  pending_learning
  learning
  pending_exam
  remediation_required
  locked
  pending_signature
  confirmation_pending
  completed
  cancelled
}

enum AttemptStatus {
  in_progress
  submitted
  expired
}

enum NotificationStatus {
  unread
  read
}

enum ChangeRequestType {
  binding
  profile_change
  registration
  binding_change
  department_transfer
  account_merge
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
  duplicate
  cancelled
}

enum OutboxStatus {
  pending
  sent
  skipped
  failed
}

enum MonthlyReportStatus {
  draft
  submitted
  withdrawn
  voided
}

enum ReportProjectStatus {
  active
  completed
}

enum ReportFieldType {
  text
  number
  textarea
  select
  date
}

enum CertificateCategory {
  company
  personal
}

enum CertificateLifecycleStatus {
  active
  replaced
  revoked
  voided
}

enum HistoricalRecordStatus {
  active
  voided
}

enum CertificateTrainingStatus {
  trained
  not_required
  pending
}

model Account {
  id                  String           @id @default(uuid()) @db.Uuid
  username            String?          @unique @db.VarChar(80)
  passwordHash        String?          @map("password_hash")
  status              AccountStatus    @default(active)
  sessionVersion      Int              @default(0) @map("session_version")
  personId            String?          @unique @map("person_id") @db.Uuid
  verifiedPhone       String?          @unique @map("verified_phone") @db.VarChar(20)
  mergedIntoAccountId String?          @map("merged_into_account_id") @db.Uuid
  mergedAt            DateTime?        @map("merged_at")
  person              Person?          @relation(fields: [personId], references: [id])
  mergedInto          Account?         @relation("AccountMerge", fields: [mergedIntoAccountId], references: [id])
  mergedAccounts      Account[]        @relation("AccountMerge")
  roles               RoleAssignment[]
  wechatBindings      WechatBinding[]
  refreshSessions     RefreshSession[]
  preferences         UserPreference[]
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@index([mergedIntoAccountId])
  @@map("accounts")
}

model Person {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(80)
  phone              String                   @db.VarChar(20)
  type               PersonType
  status             PersonStatus             @default(pending)
  nationalIdCipher   String?                  @map("national_id_cipher")
  nationalIdIv       String?                  @map("national_id_iv")
  nationalIdTag      String?                  @map("national_id_tag")
  nationalIdHash     String?                  @map("national_id_hash") @db.VarChar(64)
  nationalIdLast4    String?                  @map("national_id_last4") @db.Char(4)
  photoFileId        String?                  @map("photo_file_id") @db.Uuid
  photoFile          PrivateFile?             @relation("PersonPhoto", fields: [photoFileId], references: [id], onDelete: Restrict)
  account            Account?
  organizations      OrganizationMembership[]
  projectMemberships ProjectMember[]
  assignments        TrainingAssignment[]
  signatures         Signature[]
  changeRequests     ChangeRequest[]
  notifications      Notification[]
  certificates       PersonCertificate[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@unique([nationalIdHash])
  @@index([phone, status])
  @@map("persons")
}

model WechatBinding {
  id        String    @id @default(uuid()) @db.Uuid
  appId     String    @map("app_id") @db.VarChar(64)
  openid    String    @db.VarChar(128)
  unionid   String?   @db.VarChar(128)
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id])
  active    Boolean   @default(true)
  boundAt   DateTime? @map("bound_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([appId, openid])
  @@map("wechat_bindings")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("refresh_sessions")
}

model Organization {
  id                      String                      @id @default(uuid()) @db.Uuid
  name                    String                      @db.VarChar(120)
  type                    OrganizationType
  parentId                String?                     @map("parent_id") @db.Uuid
  reportingEnabled        Boolean                     @default(false) @map("reporting_enabled")
  parent                  Organization?               @relation("OrganizationTree", fields: [parentId], references: [id])
  children                Organization[]              @relation("OrganizationTree")
  memberships             OrganizationMembership[]
  projects                Project[]
  qualifications          OrganizationQualification[]
  monthlyReports          ProjectMonthlyReport[]
  departmentMonthStatuses DepartmentMonthStatus[]
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")

  @@unique([parentId, name])
  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  personId       String       @map("person_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  person         Person       @relation(fields: [personId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  primary        Boolean      @default(false)
  active         Boolean      @default(true)
  endedAt        DateTime?    @map("ended_at")
  endedBy        String?      @map("ended_by") @db.Uuid
  endReason      String?      @map("end_reason") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([personId, active, primary])
  @@index([organizationId, active])
  @@map("organization_memberships")
}

model RoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      RoleName
  scopeType ScopeType @map("scope_type")
  scopeId   String?   @map("scope_id") @db.Uuid
  active    Boolean   @default(true)
  endedAt   DateTime? @map("ended_at")
  endedBy   String?   @map("ended_by") @db.Uuid
  endReason String?   @map("end_reason") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([role, scopeType, scopeId, active])
  @@index([accountId, active])
  @@map("role_assignments")
}

model Project {
  id                        String                 @id @default(uuid()) @db.Uuid
  name                      String                 @db.VarChar(160)
  code                      String                 @unique @db.VarChar(50)
  responsibleOrganizationId String                 @map("responsible_organization_id") @db.Uuid
  responsibleOrganization   Organization           @relation(fields: [responsibleOrganizationId], references: [id])
  status                    ProjectStatus          @default(active)
  projectType               String?                @map("project_type") @db.VarChar(120)
  location                  String?                @db.VarChar(300)
  contractAmount            Decimal?               @map("contract_amount") @db.Decimal(14, 2)
  plannedStartAt            DateTime?              @map("planned_start_at") @db.Date
  plannedEndAt              DateTime?              @map("planned_end_at") @db.Date
  managerName               String?                @map("manager_name") @db.VarChar(80)
  managerPhone              String?                @map("manager_phone") @db.VarChar(20)
  members                   ProjectMember[]
  batches                   TrainingBatch[]
  monthlyReports            ProjectMonthlyReport[]
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMember {
  id         String           @id @default(uuid()) @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  personId   String           @map("person_id") @db.Uuid
  project    Project          @relation(fields: [projectId], references: [id])
  person     Person           @relation(fields: [personId], references: [id])
  status     MembershipStatus @default(pending)
  reviewedBy String?          @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?        @map("reviewed_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([projectId, personId])
  @@map("project_members")
}

model PrivateFile {
  id                         String                           @id @default(uuid()) @db.Uuid
  kind                       FileKind
  storageKey                 String                           @unique @map("storage_key")
  originalName               String                           @map("original_name")
  mimeType                   String                           @map("mime_type")
  size                       Int
  sha256                     String                           @db.VarChar(64)
  uploadedBy                 String                           @map("uploaded_by") @db.Uuid
  personPhotos               Person[]                         @relation("PersonPhoto")
  versions                   CoursewareVersion[]
  signatures                 Signature[]
  personCertificates         PersonCertificate[]
  organizationQualifications OrganizationQualification[]
  certificateAttachments     CertificateAttachment[]
  monthlyReportAttachments   ProjectMonthlyReportAttachment[]
  createdAt                  DateTime                         @default(now()) @map("created_at")
  updatedAt                  DateTime                         @updatedAt @map("updated_at")

  @@map("files")
}

model PersonCertificate {
  id                     String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId               String                            @map("person_id") @db.Uuid
  person                 Person                            @relation(fields: [personId], references: [id])
  name                   String                            @db.VarChar(160)
  category               String?                           @db.VarChar(80)
  typeId                 String?                           @map("type_id") @db.Uuid
  type                   CertificateType?                  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  subtype1Value          String?                           @map("subtype_1_value") @db.VarChar(120)
  subtype2Value          String?                           @map("subtype_2_value") @db.VarChar(120)
  certificateNoCipher    String?                           @map("certificate_no_cipher")
  certificateNoIv        String?                           @map("certificate_no_iv")
  certificateNoTag       String?                           @map("certificate_no_tag")
  certificateNoLast4     String?                           @map("certificate_no_last4") @db.VarChar(8)
  issuingAuthority       String?                           @map("issuing_authority") @db.VarChar(160)
  issuedAt               DateTime?                         @map("issued_at") @db.Date
  validFrom              DateTime?                         @map("valid_from") @db.Date
  expiresAt              DateTime?                         @map("expires_at") @db.Date
  isLongTerm             Boolean                           @default(false) @map("is_long_term")
  holderPosition         String?                           @map("holder_position") @db.VarChar(120)
  status                 CertificateLifecycleStatus        @default(active)
  trainingStatus         CertificateTrainingStatus?        @default(pending) @map("training_status")
  remark                 String?                           @db.VarChar(2000)
  renewedFromId          String?                           @map("renewed_from_id") @db.Uuid
  renewedFrom            PersonCertificate?                @relation("PersonCertificateRenewal", fields: [renewedFromId], references: [id], onDelete: Restrict)
  renewals               PersonCertificate[]               @relation("PersonCertificateRenewal")
  renewedAt              DateTime?                         @map("renewed_at")
  voidedAt               DateTime?                         @map("voided_at")
  voidedBy               String?                           @map("voided_by") @db.Uuid
  voidReason             String?                           @map("void_reason") @db.VarChar(500)
  createdBy              String?                           @map("created_by") @db.Uuid
  fileId                 String?                           @map("file_id") @db.Uuid
  file                   PrivateFile?                      @relation(fields: [fileId], references: [id])
  attachments            CertificateAttachment[]
  trainingRecords        CertificateTrainingRecord[]
  annualTrainingStatuses CertificateAnnualTrainingStatus[]
  active                 Boolean                           @default(true)
  createdAt              DateTime                          @default(now()) @map("created_at")
  updatedAt              DateTime                          @updatedAt @map("updated_at")

  @@index([personId, active, expiresAt])
  @@map("person_certificates")
}

model OrganizationQualification {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                      @map("organization_id") @db.Uuid
  organization        Organization                @relation(fields: [organizationId], references: [id])
  name                String                      @db.VarChar(160)
  category            String?                     @db.VarChar(80)
  typeId              String?                     @map("type_id") @db.Uuid
  type                CertificateType?            @relation(fields: [typeId], references: [id], onDelete: Restrict)
  subtype1Value       String?                     @map("subtype_1_value") @db.VarChar(120)
  subtype2Value       String?                     @map("subtype_2_value") @db.VarChar(120)
  certificateNoCipher String?                     @map("certificate_no_cipher")
  certificateNoIv     String?                     @map("certificate_no_iv")
  certificateNoTag    String?                     @map("certificate_no_tag")
  certificateNoLast4  String?                     @map("certificate_no_last4") @db.VarChar(8)
  issuingAuthority    String?                     @map("issuing_authority") @db.VarChar(160)
  issuedAt            DateTime?                   @map("issued_at") @db.Date
  validFrom           DateTime?                   @map("valid_from") @db.Date
  expiresAt           DateTime?                   @map("expires_at") @db.Date
  isLongTerm          Boolean                     @default(false) @map("is_long_term")
  status              CertificateLifecycleStatus  @default(active)
  remark              String?                     @db.VarChar(2000)
  renewedFromId       String?                     @map("renewed_from_id") @db.Uuid
  renewedFrom         OrganizationQualification?  @relation("OrganizationQualificationRenewal", fields: [renewedFromId], references: [id], onDelete: Restrict)
  renewals            OrganizationQualification[] @relation("OrganizationQualificationRenewal")
  renewedAt           DateTime?                   @map("renewed_at")
  createdBy           String?                     @map("created_by") @db.Uuid
  scope               String?
  voidedAt            DateTime?                   @map("voided_at")
  voidedBy            String?                     @map("voided_by") @db.Uuid
  voidReason          String?                     @map("void_reason") @db.VarChar(500)
  fileId              String?                     @map("file_id") @db.Uuid
  file                PrivateFile?                @relation(fields: [fileId], references: [id])
  attachments         CertificateAttachment[]
  active              Boolean                     @default(true)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@index([organizationId, active, expiresAt], map: "organization_qualifications_organization_id_active_expires_at_i")
  @@map("organization_qualifications")
}

model CertificateType {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @unique @db.VarChar(160)
  category                   CertificateCategory
  subtype1Label              String?                     @map("subtype_1_label") @db.VarChar(80)
  subtype1Options            Json                        @default("[]") @map("subtype_1_options")
  subtype2Label              String?                     @map("subtype_2_label") @db.VarChar(80)
  subtype2Options            Json                        @default("[]") @map("subtype_2_options")
  sortOrder                  Int                         @default(0) @map("sort_order")
  active                     Boolean                     @default(true)
  requiresAnnualTraining     Boolean                     @default(false) @map("requires_annual_training")
  personCertificates         PersonCertificate[]
  organizationQualifications OrganizationQualification[]
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  @@index([category, active, sortOrder])
  @@map("certificate_types")
}

model CertificateAttachment {
  id                          String                     @id @default(uuid()) @db.Uuid
  fileId                      String                     @map("file_id") @db.Uuid
  file                        PrivateFile                @relation(fields: [fileId], references: [id])
  personCertificateId         String?                    @map("person_certificate_id") @db.Uuid
  personCertificate           PersonCertificate?         @relation(fields: [personCertificateId], references: [id], onDelete: Cascade)
  organizationQualificationId String?                    @map("organization_qualification_id") @db.Uuid
  organizationQualification   OrganizationQualification? @relation(fields: [organizationQualificationId], references: [id], onDelete: Cascade)
  createdBy                   String                     @map("created_by") @db.Uuid
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")

  @@unique([fileId])
  @@map("certificate_attachments")
}

model CertificateTrainingRecord {
  id                   String                      @id @default(uuid()) @db.Uuid
  personCertificateId  String                      @map("person_certificate_id") @db.Uuid
  personCertificate    PersonCertificate           @relation(fields: [personCertificateId], references: [id], onDelete: Cascade)
  year                 Int
  trainingDate         DateTime                    @map("training_date") @db.Date
  content              String                      @db.VarChar(1000)
  trainingOrganization String?                     @map("training_organization") @db.VarChar(160)
  hours                Decimal?                    @db.Decimal(6, 2)
  result               String?                     @db.VarChar(120)
  remark               String?                     @db.VarChar(1000)
  createdBy            String                      @map("created_by") @db.Uuid
  status               HistoricalRecordStatus      @default(active)
  correctionOfId       String?                     @map("correction_of_id") @db.Uuid
  correctionOf         CertificateTrainingRecord?  @relation("CertificateTrainingCorrection", fields: [correctionOfId], references: [id])
  corrections          CertificateTrainingRecord[] @relation("CertificateTrainingCorrection")
  voidedAt             DateTime?                   @map("voided_at")
  voidedBy             String?                     @map("voided_by") @db.Uuid
  voidReason           String?                     @map("void_reason") @db.VarChar(500)
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  @@index([personCertificateId, year])
  @@map("certificate_training_records")
}

model CertificateAnnualTrainingStatus {
  id                  String                    @id @default(uuid()) @db.Uuid
  personCertificateId String                    @map("person_certificate_id") @db.Uuid
  personCertificate   PersonCertificate         @relation(fields: [personCertificateId], references: [id], onDelete: NoAction)
  year                Int
  status              CertificateTrainingStatus @default(pending)
  reason              String?                   @db.VarChar(500)
  setBy               String?                   @map("set_by") @db.Uuid
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  @@unique([personCertificateId, year], map: "certificate_annual_training_statuses_person_certificate_id_year")
  @@index([year, status])
  @@map("certificate_annual_training_statuses")
}

model CertificateSetting {
  id        String   @id @default("default") @db.VarChar(32)
  warnDays  Int      @default(90) @map("warn_days")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("certificate_settings")
}

model ProjectMonthlyReport {
  id                        String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                 String                           @map("project_id") @db.Uuid
  project                   Project                          @relation(fields: [projectId], references: [id])
  reportingOrganizationId   String                           @map("reporting_organization_id") @db.Uuid
  reportingOrganization     Organization                     @relation(fields: [reportingOrganizationId], references: [id])
  reportMonth               DateTime                         @map("report_month") @db.Date
  status                    MonthlyReportStatus              @default(submitted)
  progressSummary           String                           @map("progress_summary")
  projectTypeId             String?                          @map("project_type_id") @db.Uuid
  projectType               ReportProjectType?               @relation(fields: [projectTypeId], references: [id], onDelete: Restrict)
  constructionLocation      String?                          @map("construction_location") @db.VarChar(300)
  contractAmount            Decimal                          @default(0) @map("contract_amount") @db.Decimal(14, 2)
  durationMonths            Int?                             @map("duration_months")
  departmentEntity          String?                          @map("department_entity") @db.VarChar(160)
  projectManager            String?                          @map("project_manager") @db.VarChar(80)
  contactInfo               String?                          @map("contact_info") @db.VarChar(120)
  overallProgress           String?                          @map("overall_progress")
  monthlyConstructionStatus String?                          @map("monthly_construction_status")
  equipmentModels           String?                          @map("equipment_models")
  onsiteCount               Int                              @default(0) @map("onsite_count")
  onsiteVehicles            Int                              @default(0) @map("onsite_vehicles")
  safetyInspection          Boolean                          @default(false) @map("safety_inspection")
  safetyHazards             Boolean                          @default(false) @map("safety_hazards")
  safetyHazardDetail        String?                          @map("safety_hazard_detail")
  safetyHazardCount         Int                              @default(0) @map("safety_hazard_count")
  rectifiedHazardCount      Int                              @default(0) @map("rectified_hazard_count")
  safetyInvestment          Decimal                          @default(0) @map("safety_investment") @db.Decimal(14, 2)
  incidentCount             Int                              @default(0) @map("incident_count")
  notes                     String?
  projectStatus             ReportProjectStatus              @default(active) @map("project_status")
  customData                Json                             @default("{}") @map("custom_data")
  projectSnapshot           Json                             @default("{}") @map("project_snapshot")
  fieldSnapshot             Json                             @default("[]") @map("field_snapshot")
  revision                  Int                              @default(1)
  submittedBy               String?                          @map("submitted_by") @db.Uuid
  submittedAt               DateTime?                        @map("submitted_at")
  withdrawnBy               String?                          @map("withdrawn_by") @db.Uuid
  withdrawnAt               DateTime?                        @map("withdrawn_at")
  withdrawalReason          String?                          @map("withdrawal_reason") @db.VarChar(500)
  voidedBy                  String?                          @map("voided_by") @db.Uuid
  voidedAt                  DateTime?                        @map("voided_at")
  voidReason                String?                          @map("void_reason") @db.VarChar(500)
  updatedBy                 String                           @map("updated_by") @db.Uuid
  revisions                 ProjectMonthlyReportRevision[]
  attachments               ProjectMonthlyReportAttachment[]
  createdAt                 DateTime                         @default(now()) @map("created_at")
  updatedAt                 DateTime                         @updatedAt @map("updated_at")

  @@index([projectId, reportMonth, status])
  @@index([reportingOrganizationId, reportMonth], map: "project_monthly_reports_reporting_organization_id_report_month_")
  @@map("project_monthly_reports")
}

model ProjectMonthlyReportRevision {
  id             String               @id @default(uuid()) @db.Uuid
  reportId       String               @map("report_id") @db.Uuid
  report         ProjectMonthlyReport @relation(fields: [reportId], references: [id], onDelete: NoAction)
  revision       Int
  beforeSnapshot Json                 @map("before_snapshot")
  changedBy      String               @map("changed_by") @db.Uuid
  reason         String?              @db.VarChar(500)
  createdAt      DateTime             @default(now()) @map("created_at")

  @@unique([reportId, revision])
  @@map("project_monthly_report_revisions")
}

model ProjectMonthlyReportAttachment {
  id        String               @id @default(uuid()) @db.Uuid
  reportId  String               @map("report_id") @db.Uuid
  report    ProjectMonthlyReport @relation(fields: [reportId], references: [id], onDelete: NoAction)
  fileId    String               @unique @map("file_id") @db.Uuid
  file      PrivateFile          @relation(fields: [fileId], references: [id], onDelete: NoAction)
  createdBy String               @map("created_by") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at")

  @@map("project_monthly_report_attachments")
}

model ReportProjectType {
  id        String                 @id @default(uuid()) @db.Uuid
  name      String                 @unique @db.VarChar(160)
  sortOrder Int                    @default(0) @map("sort_order")
  active    Boolean                @default(true)
  reports   ProjectMonthlyReport[]
